# NoteApp environment file. Copy to /opt/noteapp/<env>/.env, fill it in, then
#   chmod 600 .env
# Never commit the real file. Every value below is a placeholder.
# Variables: docs/DEPLOY_CONTRACT.md
#
# Format rule: comments go on their OWN line. A trailing "# ..." after an empty
# value becomes the value itself.

# ===== Compose settings (used by compose.yaml; harmless to the app) =====
# Environment name: staging | prod. Also names the compose project.
NOTEAPP_ENV=staging
# Image tag to run: staging | prod | vX.Y.Z | sha-<short>. Pin a tag to roll back.
NOTEAPP_TAG=staging
# Localhost port cloudflared points at. Must differ per env (e.g. staging 3002, prod 3001).
HOST_PORT=3002

# ===== App: required =====
NODE_ENV=production
# prod: https://notes.devswartz.com
PUBLIC_URL=https://notes-staging.devswartz.com
# 64+ random bytes, different per environment:
#   openssl rand -base64 64 | tr -d '\n'
JWT_SECRET=

# ===== App: optional (leave unset; the image defaults are correct) =====
# DATA_DIR=/data
# PORT=3001

# ===== Email via AWS SES SMTP =====
# If these are missing, the app starts, logs a warning and skips email reminders.
# Host looks like email-smtp.<region>.amazonaws.com
SMTP_HOST=
# 587 = STARTTLS
SMTP_PORT=587
# SES SMTP credentials (IAM user limited to ses:SendRawEmail)
SMTP_USER=
SMTP_PASS=
MAIL_FROM=NoteApp <notes@devswartz.com>

# ===== Web push =====
# Generate once per environment: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Format: mailto:<admin address>
VAPID_SUBJECT=

# ===== Staging only =====
# Loads demo content into an empty DB. Delete this line (or set 0) on prod.
SEED_DEMO=1

# ===== Proxy / rate limiting =====
# cf = trust CF-Connecting-IP for the client IP. Only safe because the app port
# is reachable solely through cloudflared (compose binds 127.0.0.1).
TRUST_PROXY_HEADER=cf

# ===== Native app push (optional until the apps ship; see docs/MOBILE.md) =====
# APNs token auth for iOS. APNS_PRIVATE_KEY is the .p8 contents, newlines as \n.
# APNS_KEY_ID=
# APNS_TEAM_ID=
# APNS_BUNDLE_ID=com.devswartz.noteapp
# APNS_PRIVATE_KEY=
# APNS_ENV=production
# Firebase service-account JSON for Android (one line, or base64)
# FCM_SERVICE_ACCOUNT_JSON=
# App links: SHA-256 of the Play app-signing and upload certs, comma-separated (PR #57)
# ANDROID_CERT_SHA256=

# ===== Admin =====
# Instance admins (GET /api/admin/stats), comma-separated. Set BEFORE the first
# sign-up: if unset, the first account ever created becomes the admin.
ADMIN_EMAILS=

# ===== Staging only (optional) =====
# Known password for the SEED_DEMO accounts (otherwise random, printed once in the log)
# DEMO_PASSWORD=

# Never set in production: ACCESS_TOKEN_TTL_S (default 900 s is correct)
