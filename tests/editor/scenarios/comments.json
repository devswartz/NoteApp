{
  "scenarios": [
    {"name": "setComment marks the selection", "doc": "<paragraph>a[bc]d</paragraph>", "steps": [{"command": "setComment", "args": {"threadId": "c1"}}],
      "expect": {"doc": "<paragraph>a<comment threadId=\"c1\">[bc]</comment>d</paragraph>"}},
    {"name": "setComment across two paragraphs marks both", "doc": "<paragraph>a[b</paragraph><paragraph>c]d</paragraph>", "steps": [{"command": "setComment", "args": {"threadId": "c1"}}],
      "expect": {"doc": "<paragraph>a<comment threadId=\"c1\">[b</comment></paragraph><paragraph><comment threadId=\"c1\">c]</comment>d</paragraph>"}},
    {"name": "setComment over bold text keeps the bold", "doc": "<paragraph>a<bold>[bc]</bold>d</paragraph>", "steps": [{"command": "setComment", "args": {"threadId": "c1"}}],
      "expect": {"doc": "<paragraph>a<bold><comment threadId=\"c1\">[bc]</comment></bold>d</paragraph>"}},
    {"name": "typing at the end of a comment is outside it", "doc": "<paragraph>a<comment threadId=\"c1\">bc|</comment>d</paragraph>", "steps": [{"type": "x"}],
      "expect": {"doc": "<paragraph>a<comment threadId=\"c1\">bc</comment>x|d</paragraph>"}},
    {"name": "typing at the start of a comment is outside it", "doc": "<paragraph>a|<comment threadId=\"c1\">bc</comment>d</paragraph>", "steps": [{"type": "x"}],
      "expect": {"doc": "<paragraph>ax|<comment threadId=\"c1\">bc</comment>d</paragraph>"}},
    {"name": "typing inside a comment stays in it", "doc": "<paragraph>a<comment threadId=\"c1\">b|c</comment>d</paragraph>", "steps": [{"type": "xy"}],
      "expect": {"doc": "<paragraph>a<comment threadId=\"c1\">bxy|c</comment>d</paragraph>"}},
    {"name": "typing over a whole comment", "doc": "<paragraph>a<comment threadId=\"c1\">[bc]</comment>d</paragraph>", "steps": [{"type": "x"}],
      "expect": {"doc": "<paragraph>ax|d</paragraph>"}},
    {"name": "typing over part of a comment keeps the anchor around the rest", "doc": "<paragraph>a<comment threadId=\"c1\">b[c]e</comment>d</paragraph>", "steps": [{"type": "x"}],
      "expect": {"doc": "<paragraph>a<comment threadId=\"c1\">bx|e</comment>d</paragraph>"}},
    {"name": "Enter inside a comment splits the anchor in two", "doc": "<paragraph><comment threadId=\"c1\">ab|cd</comment></paragraph>", "steps": [{"key": "Enter"}],
      "expect": {"doc": "<paragraph><comment threadId=\"c1\">ab</comment></paragraph><paragraph><comment threadId=\"c1\">|cd</comment></paragraph>"}},
    {"name": "Backspace joins two paragraphs and the anchor runs on", "doc": "<paragraph><comment threadId=\"c1\">ab</comment></paragraph><paragraph>|<comment threadId=\"c1\">cd</comment></paragraph>", "steps": [{"key": "Backspace"}],
      "expect": {"doc": "<paragraph><comment threadId=\"c1\">ab|cd</comment></paragraph>"}},
    {"name": "Backspace joins a plain line onto a comment", "doc": "<paragraph><comment threadId=\"c1\">ab</comment></paragraph><paragraph>|cd</paragraph>", "steps": [{"key": "Backspace"}],
      "expect": {"doc": "<paragraph><comment threadId=\"c1\">ab</comment>|cd</paragraph>"}},
    {"name": "Backspace deletes a character of a comment", "doc": "<paragraph><comment threadId=\"c1\">abc|</comment>d</paragraph>", "steps": [{"key": "Backspace"}, {"type": "x"}],
      "expect": {"doc": "<paragraph><comment threadId=\"c1\">ab</comment>x|d</paragraph>"}},
    {"name": "deleting all the commented text removes the anchor", "doc": "<paragraph>a<comment threadId=\"c1\">[bc]</comment>d</paragraph>", "steps": [{"key": "Backspace"}, {"type": "x"}],
      "expect": {"doc": "<paragraph>ax|d</paragraph>"}},
    {"name": "Delete before a comment removes its first letter", "doc": "<paragraph>a|<comment threadId=\"c1\">bc</comment>d</paragraph>", "steps": [{"key": "Delete"}],
      "expect": {"doc": "<paragraph>a|<comment threadId=\"c1\">c</comment>d</paragraph>"}},
    {"name": "two comments overlap", "doc": "<paragraph><comment threadId=\"c1\">a[b</comment>c]d</paragraph>", "steps": [{"command": "setComment", "args": {"threadId": "c2"}}],
      "expect": {"doc": "<paragraph><comment threadId=\"c1\">a<comment threadId=\"c2\">[b</comment></comment><comment threadId=\"c2\">c]</comment>d</paragraph>"}},
    {"name": "unsetComment removes one thread's anchors", "doc": "<paragraph><comment threadId=\"c1\">a|b</comment><comment threadId=\"c2\">cd</comment></paragraph>", "steps": [{"command": "unsetComment", "args": {"threadId": "c1"}}],
      "expect": {"doc": "<paragraph>a|b<comment threadId=\"c2\">cd</comment></paragraph>"}},
    {"name": "Mod+b over commented text keeps the comment", "doc": "<paragraph>a<comment threadId=\"c1\">[bc]</comment>d</paragraph>", "steps": [{"key": "Mod+b"}],
      "expect": {"doc": "<paragraph>a<bold><comment threadId=\"c1\">[bc]</comment></bold>d</paragraph>"}},
    {"name": "undo takes back setComment", "doc": "<paragraph>a[bc]d</paragraph>", "steps": [{"command": "setComment", "args": {"threadId": "c1"}}, {"command": "undo"}],
      "expect": {"doc": "<paragraph>a[bc]d</paragraph>"}},
    {"name": "copy a comment: the HTML carries the thread id", "doc": "<paragraph>a<comment threadId=\"c1\">[bc]</comment>d</paragraph>", "steps": [{"copy": {"text": "bc", "html": "<p data-pm-slice=\"1 1 []\"><span data-thread-id=\"c1\" class=\"comment-anchor\">bc</span></p>"}}],
      "expect": {"doc": "<paragraph>a<comment threadId=\"c1\">[bc]</comment>d</paragraph>"}},
    {"name": "paste a comment's HTML keeps the anchor", "doc": "<paragraph>a|b</paragraph>", "steps": [{"paste": {"text/html": "<span data-thread-id=\"c1\" class=\"comment-anchor\">xy</span>", "text/plain": "xy"}}],
      "expect": {"doc": "<paragraph>a<comment threadId=\"c1\">xy|</comment>b</paragraph>"}},
    {"name": "paste plain text inside a comment stays in it", "doc": "<paragraph><comment threadId=\"c1\">a|b</comment></paragraph>", "steps": [{"paste": {"text/plain": "xy"}}],
      "expect": {"doc": "<paragraph><comment threadId=\"c1\">axy|b</comment></paragraph>"}},
    {"name": "paste plain text over a comment drops it", "doc": "<paragraph>a<comment threadId=\"c1\">[bc]</comment>d</paragraph>", "steps": [{"paste": {"text/plain": "xy"}}],
      "expect": {"doc": "<paragraph>axy|d</paragraph>"}},
    {"name": "cut a comment removes its text and anchor", "doc": "<paragraph>a<comment threadId=\"c1\">[bc]</comment>d</paragraph>", "steps": [{"copy": {"text": "bc"}, "cut": true}, {"type": "x"}],
      "expect": {"doc": "<paragraph>ax|d</paragraph>"}}
  ]
}
