{
  "scenarios": [
    { "name": "1. makes a numbered list", "doc": "<paragraph>|</paragraph>", "steps": [{ "type": "1. a" }],
      "expect": { "doc": "<orderedList><listItem><paragraph>a|</paragraph></listItem></orderedList><paragraph/>" } },
    { "name": "3) starts numbering at 3 with parens", "doc": "<paragraph>|</paragraph>", "steps": [{ "type": "3) a" }],
      "expect": { "doc": "<orderedList start=3 paren=true><listItem><paragraph>a|</paragraph></listItem></orderedList><paragraph/>" } },
    { "name": "a. makes a lettered list", "doc": "<paragraph>|</paragraph>", "steps": [{ "type": "a. x" }],
      "expect": { "doc": "<orderedList type=\"a\"><listItem><paragraph>x|</paragraph></listItem></orderedList><paragraph/>" } },
    { "name": "star space makes a bullet", "doc": "<paragraph>|</paragraph>", "steps": [{ "type": "* x" }],
      "expect": { "doc": "<bulletList><listItem><paragraph>x|</paragraph></listItem></bulletList><paragraph/>" } },
    { "name": "Enter in a bullet makes the next bullet", "doc": "<bulletList><listItem><paragraph>a|</paragraph></listItem></bulletList>",
      "steps": [{ "key": "Enter" }, { "type": "b" }],
      "expect": { "doc": "<bulletList><listItem><paragraph>a</paragraph></listItem><listItem><paragraph>b|</paragraph></listItem></bulletList><paragraph/>" } },
    { "name": "Enter on an empty top-level bullet leaves the list", "doc": "<bulletList><listItem><paragraph>a</paragraph></listItem><listItem><paragraph>|</paragraph></listItem></bulletList>",
      "steps": [{ "key": "Enter" }],
      "expect": { "doc": "<bulletList><listItem><paragraph>a</paragraph></listItem></bulletList><paragraph>|</paragraph><paragraph/>" } },
    { "name": "Tab nests a bullet under the one above", "doc": "<bulletList><listItem><paragraph>a</paragraph></listItem><listItem><paragraph>|b</paragraph></listItem></bulletList>",
      "steps": [{ "key": "Tab" }],
      "expect": { "doc": "<bulletList><listItem><paragraph>a</paragraph><bulletList><listItem><paragraph>|b</paragraph></listItem></bulletList></listItem></bulletList><paragraph/>" } },
    { "name": "Tab on the first bullet stays put", "doc": "<bulletList><listItem><paragraph>|a</paragraph></listItem></bulletList>",
      "steps": [{ "key": "Tab" }],
      "expect": { "doc": "<bulletList><listItem><paragraph>|a</paragraph></listItem></bulletList><paragraph/>" } },
    { "name": "Shift+Tab outdents a nested bullet", "doc": "<bulletList><listItem><paragraph>a</paragraph><bulletList><listItem><paragraph>b|</paragraph></listItem></bulletList></listItem></bulletList>",
      "steps": [{ "key": "Shift+Tab" }],
      "expect": { "doc": "<bulletList><listItem><paragraph>a</paragraph></listItem><listItem><paragraph>b|</paragraph></listItem></bulletList><paragraph/>" } },
    { "name": "Shift+Tab on a top-level bullet leaves the list", "doc": "<bulletList><listItem><paragraph>a|</paragraph></listItem></bulletList>",
      "steps": [{ "key": "Shift+Tab" }],
      "expect": { "doc": "<paragraph>a|</paragraph><paragraph/>" } },
    { "name": "Enter on an empty nested bullet outdents it", "doc": "<bulletList><listItem><paragraph>a</paragraph><bulletList><listItem><paragraph>b</paragraph></listItem><listItem><paragraph>|</paragraph></listItem></bulletList></listItem></bulletList>",
      "steps": [{ "key": "Enter" }],
      "expect": { "doc": "<bulletList><listItem><paragraph>a</paragraph><bulletList><listItem><paragraph>b</paragraph></listItem></bulletList></listItem><listItem><paragraph>|</paragraph></listItem></bulletList><paragraph/>" } },
    { "name": "Backspace at the start of a bullet lifts it to a paragraph", "doc": "<bulletList><listItem><paragraph>a</paragraph></listItem><listItem><paragraph>|b</paragraph></listItem></bulletList>",
      "steps": [{ "key": "Backspace" }],
      "expect": { "doc": "<bulletList><listItem><paragraph>a</paragraph></listItem></bulletList><paragraph>|b</paragraph><paragraph/>" } },
    { "name": "Mod+. toggles a bullet", "doc": "<paragraph>a|</paragraph>", "steps": [{ "key": "Mod+." }],
      "expect": { "doc": "<bulletList><listItem><paragraph>a|</paragraph></listItem></bulletList><paragraph/>" } },
    { "name": "toggleOrderedList command", "doc": "<paragraph>a|</paragraph>", "steps": [{ "command": "toggleOrderedList" }],
      "expect": { "doc": "<orderedList><listItem><paragraph>a|</paragraph></listItem></orderedList><paragraph/>" } },
    { "name": "toggleBulletList twice is a paragraph again", "doc": "<paragraph>a|</paragraph>", "steps": [{ "command": "toggleBulletList" }, { "command": "toggleBulletList" }],
      "expect": { "doc": "<paragraph>a|</paragraph><paragraph/>" } },
    { "name": "bullet list becomes numbered", "doc": "<bulletList><listItem><paragraph>a|</paragraph></listItem><listItem><paragraph>b</paragraph></listItem></bulletList>",
      "steps": [{ "command": "toggleOrderedList" }],
      "expect": { "doc": "<orderedList><listItem><paragraph>a|</paragraph></listItem><listItem><paragraph>b</paragraph></listItem></orderedList><paragraph/>" } },
    { "name": "checklist from the ribbon", "doc": "<paragraph>a|</paragraph>", "steps": [{ "command": "toggleChecklist" }],
      "expect": { "doc": "<taskList><taskItem><paragraph>a|</paragraph></taskItem></taskList><paragraph/>" } },
    { "name": "Enter in a checklist adds an unchecked item", "doc": "<taskList><taskItem checked=true><paragraph>a|</paragraph></taskItem></taskList>",
      "steps": [{ "key": "Enter" }, { "type": "b" }],
      "expect": { "doc": "<taskList><taskItem checked=true><paragraph>a</paragraph></taskItem><taskItem><paragraph>b|</paragraph></taskItem></taskList><paragraph/>" } },
    { "name": "[ ] does not make a checklist", "doc": "<paragraph>|</paragraph>", "steps": [{ "type": "[ ] a" }],
      "expect": { "doc": "<paragraph>\\[ \\] a|</paragraph>" } },
    { "name": "Tab nests a checklist item", "doc": "<taskList><taskItem><paragraph>a</paragraph></taskItem><taskItem><paragraph>b|</paragraph></taskItem></taskList>",
      "steps": [{ "key": "Tab" }],
      "expect": { "doc": "<taskList><taskItem><paragraph>a</paragraph><taskList><taskItem><paragraph>b|</paragraph></taskItem></taskList></taskItem></taskList><paragraph/>" } },
    {"name": "Mod+Shift+8 makes a bullet list", "doc": "<paragraph>a|</paragraph>", "steps": [{"key": "Mod+Shift+8"}], "expect": {"doc": "<bulletList><listItem><paragraph>a|</paragraph></listItem></bulletList><paragraph/>"}},
    {"name": "Mod+Shift+7 makes a numbered list", "doc": "<paragraph>a|</paragraph>", "steps": [{"key": "Mod+Shift+7"}], "expect": {"doc": "<orderedList><listItem><paragraph>a|</paragraph></listItem></orderedList><paragraph/>"}},
    {"name": "Mod+Shift+9 makes a checklist", "doc": "<paragraph>a|</paragraph>", "steps": [{"key": "Mod+Shift+9"}], "expect": {"doc": "<taskList><taskItem><paragraph>a|</paragraph></taskItem></taskList><paragraph/>"}},
    {"name": "i. makes a roman numeral list", "doc": "<paragraph>|</paragraph>", "steps": [{"type": "i. x"}], "expect": {"doc": "<orderedList type=\"i\"><listItem><paragraph>x|</paragraph></listItem></orderedList><paragraph/>"}},
    {"name": "Enter in a numbered list continues it", "doc": "<orderedList><listItem><paragraph>a|</paragraph></listItem></orderedList><paragraph/>", "steps": [{"key": "Enter"}, {"type": "b"}], "expect": {"doc": "<orderedList><listItem><paragraph>a</paragraph></listItem><listItem><paragraph>b|</paragraph></listItem></orderedList><paragraph/>"}},
    {"name": "Tab nests a numbered item", "doc": "<orderedList><listItem><paragraph>a</paragraph></listItem><listItem><paragraph>b|</paragraph></listItem></orderedList><paragraph/>", "steps": [{"key": "Tab"}], "expect": {"doc": "<orderedList><listItem><paragraph>a</paragraph><orderedList><listItem><paragraph>b|</paragraph></listItem></orderedList></listItem></orderedList><paragraph/>"}},
    {"name": "Enter in the middle of a bullet splits it", "doc": "<bulletList><listItem><paragraph>ab|cd</paragraph></listItem></bulletList><paragraph/>", "steps": [{"key": "Enter"}], "expect": {"doc": "<bulletList><listItem><paragraph>ab</paragraph></listItem><listItem><paragraph>|cd</paragraph></listItem></bulletList><paragraph/>"}},
    {"name": "Alt+Shift+ArrowUp moves a bullet up in its list", "doc": "<bulletList><listItem><paragraph>a</paragraph></listItem><listItem><paragraph>b|</paragraph></listItem></bulletList><paragraph/>", "steps": [{"key": "Alt+Shift+ArrowUp"}], "expect": {"doc": "<bulletList><listItem><paragraph>b|</paragraph></listItem><listItem><paragraph>a</paragraph></listItem></bulletList><paragraph/>"}},
    {"name": "Alt+Shift+ArrowDown moves a bullet with its sub-points", "doc": "<bulletList><listItem><paragraph>a|</paragraph><bulletList><listItem><paragraph>a1</paragraph></listItem></bulletList></listItem><listItem><paragraph>b</paragraph></listItem></bulletList><paragraph/>", "steps": [{"key": "Alt+Shift+ArrowDown"}], "expect": {"doc": "<bulletList><listItem><paragraph>b</paragraph></listItem><listItem><paragraph>a|</paragraph><bulletList><listItem><paragraph>a1</paragraph></listItem></bulletList></listItem></bulletList><paragraph/>"}},
    {"name": "Backspace at the start of a second bullet lifts it out of the list", "doc": "<bulletList><listItem><paragraph>a</paragraph></listItem><listItem><paragraph>|b</paragraph></listItem></bulletList><paragraph/>", "steps": [{"key": "Backspace"}], "expect": {"doc": "<bulletList><listItem><paragraph>a</paragraph></listItem></bulletList><paragraph>|b</paragraph><paragraph/>"}},
    {"name": "Enter on an empty checklist item leaves the checklist", "doc": "<taskList><taskItem><paragraph>a</paragraph></taskItem><taskItem><paragraph>|</paragraph></taskItem></taskList><paragraph/>", "steps": [{"key": "Enter"}], "expect": {"doc": "<taskList><taskItem><paragraph>a</paragraph></taskItem></taskList><paragraph>|</paragraph><paragraph/>"}},
    {"name": "Mod+Shift+8 over two paragraphs makes one list", "doc": "<paragraph>[ab</paragraph><paragraph>cd]</paragraph>", "steps": [{"key": "Mod+Shift+8"}], "expect": {"doc": "<bulletList><listItem><paragraph>[ab</paragraph></listItem><listItem><paragraph>cd]</paragraph></listItem></bulletList><paragraph></paragraph>"}},
    {"name": "Mod+Shift+8 over a whole list makes paragraphs again", "doc": "<bulletList><listItem><paragraph>[a</paragraph></listItem><listItem><paragraph>b]</paragraph></listItem></bulletList>", "steps": [{"key": "Mod+Shift+8"}], "expect": {"doc": "<paragraph>[a</paragraph><paragraph>b]</paragraph><paragraph></paragraph>"}},
    {"name": "Tab on a nested bullet nests it a level deeper", "doc": "<bulletList><listItem><paragraph>a</paragraph><bulletList><listItem><paragraph>b</paragraph></listItem><listItem><paragraph>|c</paragraph></listItem></bulletList></listItem></bulletList>", "steps": [{"key": "Tab"}], "expect": {"doc": "<bulletList><listItem><paragraph>a</paragraph><bulletList><listItem><paragraph>b</paragraph><bulletList><listItem><paragraph>|c</paragraph></listItem></bulletList></listItem></bulletList></listItem></bulletList><paragraph></paragraph>"}},
    {"name": "Shift+Tab on a middle nested bullet takes the ones after it along", "doc": "<bulletList><listItem><paragraph>a</paragraph><bulletList><listItem><paragraph>b</paragraph></listItem><listItem><paragraph>|c</paragraph></listItem><listItem><paragraph>d</paragraph></listItem></bulletList></listItem></bulletList>", "steps": [{"key": "Shift+Tab"}], "expect": {"doc": "<bulletList><listItem><paragraph>a</paragraph><bulletList><listItem><paragraph>b</paragraph></listItem></bulletList></listItem><listItem><paragraph>|c</paragraph><bulletList><listItem><paragraph>d</paragraph></listItem></bulletList></listItem></bulletList><paragraph></paragraph>"}},
    {"name": "Tab nests a bullet with its sub-points", "doc": "<bulletList><listItem><paragraph>a</paragraph></listItem><listItem><paragraph>|b</paragraph><bulletList><listItem><paragraph>c</paragraph></listItem></bulletList></listItem></bulletList>", "steps": [{"key": "Tab"}], "expect": {"doc": "<bulletList><listItem><paragraph>a</paragraph><bulletList><listItem><paragraph>|b</paragraph><bulletList><listItem><paragraph>c</paragraph></listItem></bulletList></listItem></bulletList></listItem></bulletList><paragraph></paragraph>"}},
    {"name": "Shift+Tab on a top-level bullet with sub-points keeps them as a list", "doc": "<bulletList><listItem><paragraph>|a</paragraph><bulletList><listItem><paragraph>b</paragraph></listItem></bulletList></listItem></bulletList>", "steps": [{"key": "Shift+Tab"}], "expect": {"doc": "<paragraph>|a</paragraph><bulletList><listItem><paragraph>b</paragraph></listItem></bulletList><paragraph></paragraph>"}},
    {"name": "Tab with two bullets selected nests both", "doc": "<bulletList><listItem><paragraph>a</paragraph></listItem><listItem><paragraph>[b</paragraph></listItem><listItem><paragraph>c]</paragraph></listItem></bulletList>", "steps": [{"key": "Tab"}], "expect": {"doc": "<bulletList><listItem><paragraph>a</paragraph><bulletList><listItem><paragraph>[b</paragraph></listItem><listItem><paragraph>c]</paragraph></listItem></bulletList></listItem></bulletList><paragraph></paragraph>"}},
    {"name": "Enter on an empty nested bullet in the middle outdents it", "doc": "<bulletList><listItem><paragraph>a</paragraph><bulletList><listItem><paragraph>b</paragraph></listItem><listItem><paragraph>|</paragraph></listItem><listItem><paragraph>d</paragraph></listItem></bulletList></listItem></bulletList>", "steps": [{"key": "Enter"}], "expect": {"doc": "<bulletList><listItem><paragraph>a</paragraph><bulletList><listItem><paragraph>b</paragraph></listItem></bulletList></listItem><listItem><paragraph>|</paragraph><bulletList><listItem><paragraph>d</paragraph></listItem></bulletList></listItem></bulletList><paragraph></paragraph>"}},
    {"name": "Backspace at the start of a nested bullet lifts it a level", "doc": "<bulletList><listItem><paragraph>a</paragraph><bulletList><listItem><paragraph>|b</paragraph></listItem></bulletList></listItem></bulletList>", "steps": [{"key": "Backspace"}], "expect": {"doc": "<bulletList><listItem><paragraph>a</paragraph></listItem><listItem><paragraph>|b</paragraph></listItem></bulletList><paragraph></paragraph>"}}
  ]
}
