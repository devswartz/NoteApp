{
  "scenarios": [
    { "name": "paste plain text inline", "doc": "<paragraph>a|b</paragraph>",
      "steps": [{ "paste": { "text/plain": "XY" } }],
      "expect": { "doc": "<paragraph>aXY|b</paragraph>" } },
    { "name": "paste plain text with line breaks makes paragraphs", "doc": "<paragraph>|</paragraph>",
      "steps": [{ "paste": { "text/plain": "one\ntwo" } }],
      "expect": { "doc": "<paragraph>one</paragraph><paragraph>two|</paragraph>" } },
    { "name": "paste HTML keeps bold and italic", "doc": "<paragraph>|</paragraph>",
      "steps": [{ "paste": { "text/html": "<p>a <strong>b</strong> <em>c</em></p>", "text/plain": "a b c" } }],
      "expect": { "doc": "<paragraph>a <bold>b</bold> <italic>c|</italic></paragraph>" } },
    { "name": "paste an HTML list", "doc": "<paragraph>|</paragraph>",
      "steps": [{ "paste": { "text/html": "<ul><li>a</li><li>b</li></ul>", "text/plain": "a\nb" } }],
      "expect": { "doc": "<bulletList><listItem><paragraph>a</paragraph></listItem><listItem><paragraph>b|</paragraph></listItem></bulletList><paragraph/>" } },
    { "name": "paste HTML headings and a link", "doc": "<paragraph>|</paragraph>",
      "steps": [{ "paste": { "text/html": "<h2>T</h2><p><a href=\"https://example.com\">x</a></p>", "text/plain": "T\nx" } }],
      "expect": { "doc": "<heading level=2>T</heading><paragraph><link href=\"https://example.com\">x|</link></paragraph>" } },
    { "name": "pasted HTML drops script links", "doc": "<paragraph>|</paragraph>",
      "steps": [{ "paste": { "text/html": "<p><a href=\"javascript:alert(1)\">x</a></p>", "text/plain": "x" } }],
      "expect": { "doc": "<paragraph>x|</paragraph>" } },
    { "name": "pasted plain text keeps block Markdown as text", "doc": "<paragraph>|</paragraph>",
      "steps": [{ "paste": { "text/plain": "- a\n# T" } }],
      "expect": { "doc": "<paragraph>- a</paragraph><paragraph># T|</paragraph>" } },
    { "name": "pasted plain text applies inline Markdown", "doc": "<paragraph>|</paragraph>",
      "steps": [{ "paste": { "text/plain": "*a* and `c`" } }],
      "expect": { "doc": "<paragraph><italic>a</italic> and <code>c</code>|</paragraph>" } },
    { "name": "paste Markdown bold", "doc": "<paragraph>|</paragraph>",
      "steps": [{ "paste": { "text/plain": "a **b**" } }],
      "expect": { "doc": "<paragraph>a <bold>b|</bold></paragraph>" } },
    { "name": "paste a URL over a selection links it", "doc": "<paragraph>[ab]</paragraph>",
      "steps": [{ "paste": { "text/plain": "https://example.com" } }],
      "expect": { "doc": "<paragraph><link href=\"https://example.com\">[ab]</link></paragraph>" } },
    { "name": "copy a selection as plain text", "doc": "<paragraph>a[bc</paragraph><paragraph>d]e</paragraph>",
      "steps": [{ "copy": { "text": "bc\n\nd" } }],
      "expect": { "doc": "<paragraph>a[bc</paragraph><paragraph>d]e</paragraph>" } },
    { "name": "copy a task line as plain text", "doc": "<paragraph>[a</paragraph><taskRef taskId=\"t1\"><paragraph>note</paragraph></taskRef><paragraph>b]</paragraph>", "tasks": { "t1": { "title": "Call Sam" } },
      "steps": [{ "copy": { "text": "a\n\n[ ] Call Sam\n  note\n\nb" } }],
      "expect": { "tasks": { "t1": { "title": "Call Sam" } } } },
    { "name": "cut removes the selection and keeps a cut task", "doc": "<paragraph>[a</paragraph><taskRef taskId=\"t1\"/><paragraph>b]</paragraph>", "tasks": { "t1": { "title": "A" } },
      "steps": [{ "copy": {}, "cut": true }],
      "expect": { "doc": "<paragraph>|</paragraph>", "tasks": { "t1": { "title": "A" } } } },
    {"name": "paste an HTML numbered list", "doc": "<paragraph>|</paragraph>", "steps": [{"paste": {"text/html": "<ol><li>a</li><li>b</li></ol>"}}], "expect": {"doc": "<orderedList><listItem><paragraph>a</paragraph></listItem><listItem><paragraph>b|</paragraph></listItem></orderedList><paragraph/>"}},
    {"name": "paste HTML keeps a palette colour, drops other colours", "doc": "<paragraph>|</paragraph>", "steps": [{"paste": {"text/html": "<p><span data-color=\"red\">a</span><span style=\"color:#f00\">b</span></p>"}}], "expect": {"doc": "<paragraph><textStyle color=\"red\">a</textStyle>b|</paragraph>"}},
    {"name": "paste HTML mark is a highlight", "doc": "<paragraph>|</paragraph>", "steps": [{"paste": {"text/html": "<p>a<mark>b</mark></p>"}}], "expect": {"doc": "<paragraph>a<highlight>b|</highlight></paragraph>"}},
    {"name": "paste HTML underline and strike", "doc": "<paragraph>|</paragraph>", "steps": [{"paste": {"text/html": "<p><u>a</u><s>b</s></p>"}}], "expect": {"doc": "<paragraph><underline>a</underline><strike>b|</strike></paragraph>"}},
    {"name": "paste plain lines into a code block stays in the code block", "doc": "<codeBlock>|</codeBlock><paragraph/>", "steps": [{"paste": {"text/plain": "a\nb"}}], "expect": {"doc": "<codeBlock>a\nb|</codeBlock><paragraph/>"}},
    {"name": "paste plain text over a selection replaces it", "doc": "<paragraph>a[bc]d</paragraph>", "steps": [{"paste": {"text/plain": "X"}}], "expect": {"doc": "<paragraph>aX|d</paragraph>"}},
    {"name": "paste an HTML checklist", "doc": "<paragraph>|</paragraph>", "steps": [{"paste": {"text/html": "<ul data-type=\"taskList\"><li data-type=\"taskItem\" data-checked=\"true\"><p>a</p></li></ul>"}}], "expect": {"doc": "<taskList><taskItem checked=true><paragraph>a|</paragraph></taskItem></taskList><paragraph/>"}},
    {"name": "paste a nested HTML list", "doc": "<paragraph>|</paragraph>", "steps": [{"paste": {"text/html": "<ul><li>a<ul><li>b</li></ul></li><li>c</li></ul>"}}], "expect": {"doc": "<bulletList><listItem><paragraph>a</paragraph><bulletList><listItem><paragraph>b</paragraph></listItem></bulletList></listItem><listItem><paragraph>c|</paragraph></listItem></bulletList><paragraph></paragraph>"}},
    {"name": "paste an HTML table", "doc": "<paragraph>|</paragraph>", "steps": [{"paste": {"text/html": "<table><tr><th>h</th><th>i</th></tr><tr><td>a</td><td>b</td></tr></table>"}}], "expect": {"doc": "<table><tableRow><tableHeader><paragraph>h</paragraph></tableHeader><tableHeader><paragraph>i</paragraph></tableHeader></tableRow><tableRow><tableCell><paragraph>a</paragraph></tableCell><tableCell><paragraph>b|</paragraph></tableCell></tableRow></table><paragraph></paragraph>"}},
    {"name": "paste HTML headings h1 to h4", "doc": "<paragraph>|</paragraph>", "steps": [{"paste": {"text/html": "<h1>a</h1><h2>b</h2><h3>c</h3><h4>d</h4>"}}], "expect": {"doc": "<heading>a</heading><heading level=2>b</heading><heading level=3>c</heading><paragraph>d|</paragraph>"}},
    {"name": "paste an HTML list into a bullet", "doc": "<bulletList><listItem><paragraph>x|</paragraph></listItem></bulletList>", "steps": [{"paste": {"text/html": "<ul><li>a</li><li>b</li></ul>"}}], "expect": {"doc": "<bulletList><listItem><paragraph>xa</paragraph></listItem><listItem><paragraph>b|</paragraph></listItem></bulletList><paragraph></paragraph>"}}
  ]
}
