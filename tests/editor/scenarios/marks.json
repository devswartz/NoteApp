{
  "scenarios": [
    { "name": "Mod+b bolds a selection", "doc": "<paragraph>a[bc]d</paragraph>", "steps": [{ "key": "Mod+b" }],
      "expect": { "doc": "<paragraph>a<bold>[bc]</bold>d</paragraph>" } },
    { "name": "Mod+b twice unbolds", "doc": "<paragraph>a[bc]d</paragraph>", "steps": [{ "key": "Mod+b" }, { "key": "Mod+b" }],
      "expect": { "doc": "<paragraph>a[bc]d</paragraph>" } },
    { "name": "Mod+i italic", "doc": "<paragraph>[ab]</paragraph>", "steps": [{ "key": "Mod+i" }],
      "expect": { "doc": "<paragraph><italic>[ab]</italic></paragraph>" } },
    { "name": "Mod+u underline", "doc": "<paragraph>[ab]</paragraph>", "steps": [{ "key": "Mod+u" }],
      "expect": { "doc": "<paragraph><underline>[ab]</underline></paragraph>" } },
    { "name": "Mod+Shift+s strike", "doc": "<paragraph>[ab]</paragraph>", "steps": [{ "key": "Mod+Shift+s" }],
      "expect": { "doc": "<paragraph><strike>[ab]</strike></paragraph>" } },
    { "name": "Mod+e inline code", "doc": "<paragraph>[ab]</paragraph>", "steps": [{ "key": "Mod+e" }],
      "expect": { "doc": "<paragraph><code>[ab]</code></paragraph>" } },
    { "name": "bold and italic nest", "doc": "<paragraph>[ab]</paragraph>", "steps": [{ "key": "Mod+b" }, { "key": "Mod+i" }],
      "expect": { "doc": "<paragraph><bold><italic>[ab]</italic></bold></paragraph>" } },
    { "name": "**x** makes bold", "doc": "<paragraph>|</paragraph>", "steps": [{ "type": "**x**" }],
      "expect": { "doc": "<paragraph><bold>x</bold>|</paragraph>" } },
    { "name": "*x* makes italic", "doc": "<paragraph>|</paragraph>", "steps": [{ "type": "*x*" }],
      "expect": { "doc": "<paragraph><italic>x</italic>|</paragraph>" } },
    { "name": "`x` makes code", "doc": "<paragraph>|</paragraph>", "steps": [{ "type": "`x`" }],
      "expect": { "doc": "<paragraph><code>x</code>|</paragraph>" } },
    { "name": "~~x~~ makes strike", "doc": "<paragraph>|</paragraph>", "steps": [{ "type": "~~x~~" }],
      "expect": { "doc": "<paragraph><strike>x</strike>|</paragraph>" } },
    { "name": "typing after bold text continues bold", "doc": "<paragraph><bold>ab|</bold></paragraph>", "steps": [{ "type": "c" }],
      "expect": { "doc": "<paragraph><bold>abc|</bold></paragraph>" } },
    { "name": "text colour", "doc": "<paragraph>[ab]</paragraph>", "steps": [{ "command": "setColor", "args": { "color": "red" } }],
      "expect": { "doc": "<paragraph><textStyle color=\"red\">[ab]</textStyle></paragraph>" } },
    { "name": "highlight", "doc": "<paragraph>[ab]</paragraph>", "steps": [{ "command": "setHighlight", "args": { "color": "yellow" } }],
      "expect": { "doc": "<paragraph><highlight color=\"yellow\">[ab]</highlight></paragraph>" } },
    { "name": "set a link on a selection", "doc": "<paragraph>[ab]</paragraph>", "steps": [{ "command": "setLink", "args": { "href": "https://example.com" } }],
      "expect": { "doc": "<paragraph><link href=\"https://example.com\">[ab]</link></paragraph>" } },
    { "name": "a typed https URL becomes a link on space", "doc": "<paragraph>|</paragraph>", "steps": [{ "type": "see https://example.com " }],
      "expect": { "doc": "<paragraph>see <link href=\"https://example.com\">https://example.com</link> |</paragraph>" } },
    { "name": "a typed bare domain is not linked", "doc": "<paragraph>|</paragraph>", "steps": [{ "type": "see example.com " }],
      "expect": { "doc": "<paragraph>see example.com |</paragraph>" } },
    { "name": "remove a link", "doc": "<paragraph><link href=\"https://example.com\">[ab]</link></paragraph>", "steps": [{ "command": "unsetLink" }],
      "expect": { "doc": "<paragraph>[ab]</paragraph>" } },
    {"name": "Mod+b on a partly bold selection bolds all of it", "doc": "<paragraph>[a<bold>b</bold>c]</paragraph>", "steps": [{"key": "Mod+b"}], "expect": {"doc": "<paragraph><bold>[abc]</bold></paragraph>"}},
    {"name": "Mod+b with a caret, typed, then Mod+b again stops bold", "doc": "<paragraph>a|</paragraph>", "steps": [{"key": "Mod+b"}, {"type": "b"}, {"key": "Mod+b"}, {"type": "c"}], "expect": {"doc": "<paragraph>a<bold>b</bold>c|</paragraph>"}},
    {"name": "_x_ makes italic", "doc": "<paragraph>|</paragraph>", "steps": [{"type": "a _b_ "}], "expect": {"doc": "<paragraph>a <italic>b</italic> |</paragraph>"}},
    {"name": "__x__ makes bold", "doc": "<paragraph>|</paragraph>", "steps": [{"type": "a __b__ "}], "expect": {"doc": "<paragraph>a <bold>b</bold> |</paragraph>"}},
    {"name": "==x== makes a highlight", "doc": "<paragraph>|</paragraph>", "steps": [{"type": "a ==b== "}], "expect": {"doc": "<paragraph>a <highlight>b</highlight> |</paragraph>"}},
    {"name": "Mod+Shift+h highlights a selection", "doc": "<paragraph>a [b] c</paragraph>", "steps": [{"key": "Mod+Shift+h"}], "expect": {"doc": "<paragraph>a <highlight>[b]</highlight> c</paragraph>"}},
    {"name": "a second text colour replaces the first", "doc": "<paragraph>[ab]</paragraph>", "steps": [{"command": "setColor", "args": {"color": "red"}}, {"command": "setColor", "args": {"color": "blue"}}], "expect": {"doc": "<paragraph><textStyle color=\"blue\">[ab]</textStyle></paragraph>"}},
    {"name": "default text colour removes it", "doc": "<paragraph><textStyle color=\"red\">[ab]</textStyle></paragraph>", "steps": [{"command": "unsetColor"}], "expect": {"doc": "<paragraph>[ab]</paragraph>"}},
    {"name": "no highlight removes it", "doc": "<paragraph>a<highlight color=\"yellow\">[b]</highlight></paragraph>", "steps": [{"command": "unsetHighlight"}], "expect": {"doc": "<paragraph>a[b]</paragraph>"}},
    {"name": "colour on part of a word splits it", "doc": "<paragraph>a[b]c</paragraph>", "steps": [{"command": "setColor", "args": {"color": "green"}}], "expect": {"doc": "<paragraph>a<textStyle color=\"green\">[b]</textStyle>c</paragraph>"}},
    {"name": "typing after coloured text continues the colour", "doc": "<paragraph><textStyle color=\"red\">ab|</textStyle></paragraph>", "steps": [{"type": "c"}], "expect": {"doc": "<paragraph><textStyle color=\"red\">abc|</textStyle></paragraph>"}}
  ]
}
