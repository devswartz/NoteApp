{
  "scenarios": [
    {"name": "Backspace on a selected image deletes it", "doc": "<paragraph>a</paragraph>^<image src=\"/uploads/x1.png\"/><paragraph>b</paragraph>", "steps": [{"key": "Backspace"}], "expect": {"doc": "<paragraph>a</paragraph><paragraph>|b</paragraph>"}},
    {"name": "Delete on a selected image deletes it", "doc": "<paragraph>a</paragraph>^<image src=\"/uploads/x1.png\"/><paragraph>b</paragraph>", "steps": [{"key": "Delete"}], "expect": {"doc": "<paragraph>a</paragraph><paragraph>|b</paragraph>"}},
    {"name": "typing over a selected image replaces it", "doc": "<paragraph>a</paragraph>^<image src=\"/uploads/x1.png\"/><paragraph>b</paragraph>", "steps": [{"type": "x"}], "expect": {"doc": "<paragraph>a</paragraph><paragraph>x|</paragraph><paragraph>b</paragraph>"}},
    {"name": "Enter on a selected image", "doc": "<paragraph>a</paragraph>^<image src=\"/uploads/x1.png\"/><paragraph>b</paragraph>", "steps": [{"key": "Enter"}], "expect": {"doc": "<paragraph>a</paragraph><image src=\"/uploads/x1.png\"/><paragraph>|</paragraph><paragraph>b</paragraph>"}},
    {"name": "Backspace at the start of a line after an image deletes the image", "doc": "<image src=\"/uploads/x1.png\"/><paragraph>|b</paragraph>", "steps": [{"key": "Backspace"}], "expect": {"doc": "<paragraph>|b</paragraph>"}},
    {"name": "Backspace on an empty line after an image selects the image", "doc": "<image src=\"/uploads/x1.png\"/><paragraph>|</paragraph><paragraph>b</paragraph>", "steps": [{"key": "Backspace"}], "expect": {"doc": "^<image src=\"/uploads/x1.png\"/><paragraph>b</paragraph>"}},
    {"name": "Delete at the end of a line before an image", "doc": "<paragraph>a|</paragraph><image src=\"/uploads/x1.png\"/><paragraph>b</paragraph>", "steps": [{"key": "Delete"}], "expect": {"doc": "<paragraph>a|</paragraph><paragraph>b</paragraph>"}},
    {"name": "Delete at the end of an empty line before an image", "doc": "<paragraph>a</paragraph><paragraph>|</paragraph><image src=\"/uploads/x1.png\"/><paragraph>b</paragraph>", "steps": [{"key": "Delete"}], "expect": {"doc": "<paragraph>a</paragraph>^<image src=\"/uploads/x1.png\"/><paragraph>b</paragraph>"}},
    {"name": "typing before an image stays in its paragraph", "doc": "<paragraph>a|</paragraph><image src=\"/uploads/x1.png\"/><paragraph>b</paragraph>", "steps": [{"type": "xy"}], "expect": {"doc": "<paragraph>axy|</paragraph><image src=\"/uploads/x1.png\"/><paragraph>b</paragraph>"}},
    {"name": "Enter before an image", "doc": "<paragraph>a|</paragraph><image src=\"/uploads/x1.png\"/><paragraph>b</paragraph>", "steps": [{"key": "Enter"}, {"type": "x"}], "expect": {"doc": "<paragraph>a</paragraph><paragraph>x|</paragraph><image src=\"/uploads/x1.png\"/><paragraph>b</paragraph>"}},
    {"name": "a selection across an image deleted", "doc": "<paragraph>a[b</paragraph><image src=\"/uploads/x1.png\"/><paragraph>c]d</paragraph>", "steps": [{"key": "Backspace"}], "expect": {"doc": "<paragraph>a|d</paragraph>"}},
    {"name": "select-all over an image and typing", "doc": "<paragraph>a|</paragraph><image src=\"/uploads/x1.png\"/><paragraph>b</paragraph>", "steps": [{"key": "Mod+a"}, {"type": "x"}], "expect": {"doc": "<paragraph>x|</paragraph>"}},
    {"name": "undo brings back a deleted image", "doc": "<paragraph>a</paragraph>^<image src=\"/uploads/x1.png\"/><paragraph>b</paragraph>", "steps": [{"key": "Backspace"}, {"key": "Mod+z"}], "expect": {"doc": "<paragraph>a</paragraph>^<image src=\"/uploads/x1.png\"/><paragraph>b</paragraph>"}},
    {"name": "redo deletes the image again", "doc": "<paragraph>a</paragraph>^<image src=\"/uploads/x1.png\"/><paragraph>b</paragraph>", "steps": [{"key": "Backspace"}, {"key": "Mod+z"}, {"key": "Mod+Shift+z"}], "expect": {"doc": "<paragraph>a</paragraph><paragraph>|b</paragraph>"}},
    {"name": "paste text over a selected image", "doc": "<paragraph>a</paragraph>^<image src=\"/uploads/x1.png\"/><paragraph>b</paragraph>", "steps": [{"paste": {"text/plain": "xy"}}], "expect": {"doc": "<paragraph>a</paragraph><paragraph>xy|</paragraph><paragraph>b</paragraph>"}},
    {"name": "copy a selected image", "doc": "<paragraph>a</paragraph>^<image src=\"/uploads/x1.png\"/><paragraph>b</paragraph>", "steps": [{"copy": {"text": "", "html": "<img src=\"/uploads/x1.png\" data-pm-slice=\"0 0 []\">"}}], "expect": {"doc": "<paragraph>a</paragraph>^<image src=\"/uploads/x1.png\"/><paragraph>b</paragraph>"}},
    {"name": "cut a selected image", "doc": "<paragraph>a</paragraph>^<image src=\"/uploads/x1.png\"/><paragraph>b</paragraph>", "steps": [{"copy": {}, "cut": true}], "expect": {"doc": "<paragraph>a</paragraph><paragraph>|b</paragraph>"}},
    {"name": "two images: deleting the first keeps the second", "doc": "^<image src=\"/uploads/x1.png\"/><image src=\"/uploads/x1.png\"/><paragraph>b</paragraph>", "steps": [{"key": "Backspace"}], "expect": {"doc": "^<image src=\"/uploads/x1.png\"/><paragraph>b</paragraph>"}},
    {"name": "an image as the last block gets a paragraph after it", "doc": "<paragraph>a|</paragraph><image src=\"/uploads/x1.png\"/>", "steps": [{"type": "x"}], "expect": {"doc": "<paragraph>ax|</paragraph><image src=\"/uploads/x1.png\"/><paragraph></paragraph>"}},
    {"name": "Backspace on a selected file card deletes it", "doc": "<paragraph>a</paragraph>^<fileAttachment url=\"/files/f1\" name=\"a.pdf\" size=10 mime=\"application/pdf\"/><paragraph>b</paragraph>", "steps": [{"key": "Backspace"}], "expect": {"doc": "<paragraph>a</paragraph><paragraph>|b</paragraph>"}},
    {"name": "Delete on a selected file card deletes it", "doc": "<paragraph>a</paragraph>^<fileAttachment url=\"/files/f1\" name=\"a.pdf\" size=10 mime=\"application/pdf\"/><paragraph>b</paragraph>", "steps": [{"key": "Delete"}], "expect": {"doc": "<paragraph>a</paragraph><paragraph>|b</paragraph>"}},
    {"name": "typing over a selected file card replaces it", "doc": "<paragraph>a</paragraph>^<fileAttachment url=\"/files/f1\" name=\"a.pdf\" size=10 mime=\"application/pdf\"/><paragraph>b</paragraph>", "steps": [{"type": "x"}], "expect": {"doc": "<paragraph>a</paragraph><paragraph>x|</paragraph><paragraph>b</paragraph>"}},
    {"name": "Enter on a selected file card", "doc": "<paragraph>a</paragraph>^<fileAttachment url=\"/files/f1\" name=\"a.pdf\" size=10 mime=\"application/pdf\"/><paragraph>b</paragraph>", "steps": [{"key": "Enter"}], "expect": {"doc": "<paragraph>a</paragraph><fileAttachment mime=\"application/pdf\" name=\"a.pdf\" size=10 url=\"/files/f1\"/><paragraph>|</paragraph><paragraph>b</paragraph>"}},
    {"name": "Backspace at the start of a line after a file card deletes the file card", "doc": "<fileAttachment url=\"/files/f1\" name=\"a.pdf\" size=10 mime=\"application/pdf\"/><paragraph>|b</paragraph>", "steps": [{"key": "Backspace"}], "expect": {"doc": "<paragraph>|b</paragraph>"}},
    {"name": "Backspace on an empty line after a file card selects the file card", "doc": "<fileAttachment url=\"/files/f1\" name=\"a.pdf\" size=10 mime=\"application/pdf\"/><paragraph>|</paragraph><paragraph>b</paragraph>", "steps": [{"key": "Backspace"}], "expect": {"doc": "^<fileAttachment mime=\"application/pdf\" name=\"a.pdf\" size=10 url=\"/files/f1\"/><paragraph>b</paragraph>"}},
    {"name": "Delete at the end of a line before a file card", "doc": "<paragraph>a|</paragraph><fileAttachment url=\"/files/f1\" name=\"a.pdf\" size=10 mime=\"application/pdf\"/><paragraph>b</paragraph>", "steps": [{"key": "Delete"}], "expect": {"doc": "<paragraph>a|</paragraph><paragraph>b</paragraph>"}},
    {"name": "Delete at the end of an empty line before a file card", "doc": "<paragraph>a</paragraph><paragraph>|</paragraph><fileAttachment url=\"/files/f1\" name=\"a.pdf\" size=10 mime=\"application/pdf\"/><paragraph>b</paragraph>", "steps": [{"key": "Delete"}], "expect": {"doc": "<paragraph>a</paragraph>^<fileAttachment mime=\"application/pdf\" name=\"a.pdf\" size=10 url=\"/files/f1\"/><paragraph>b</paragraph>"}},
    {"name": "typing before a file card stays in its paragraph", "doc": "<paragraph>a|</paragraph><fileAttachment url=\"/files/f1\" name=\"a.pdf\" size=10 mime=\"application/pdf\"/><paragraph>b</paragraph>", "steps": [{"type": "xy"}], "expect": {"doc": "<paragraph>axy|</paragraph><fileAttachment mime=\"application/pdf\" name=\"a.pdf\" size=10 url=\"/files/f1\"/><paragraph>b</paragraph>"}},
    {"name": "Enter before a file card", "doc": "<paragraph>a|</paragraph><fileAttachment url=\"/files/f1\" name=\"a.pdf\" size=10 mime=\"application/pdf\"/><paragraph>b</paragraph>", "steps": [{"key": "Enter"}, {"type": "x"}], "expect": {"doc": "<paragraph>a</paragraph><paragraph>x|</paragraph><fileAttachment mime=\"application/pdf\" name=\"a.pdf\" size=10 url=\"/files/f1\"/><paragraph>b</paragraph>"}},
    {"name": "a selection across a file card deleted", "doc": "<paragraph>a[b</paragraph><fileAttachment url=\"/files/f1\" name=\"a.pdf\" size=10 mime=\"application/pdf\"/><paragraph>c]d</paragraph>", "steps": [{"key": "Backspace"}], "expect": {"doc": "<paragraph>a|d</paragraph>"}},
    {"name": "select-all over a file card and typing", "doc": "<paragraph>a|</paragraph><fileAttachment url=\"/files/f1\" name=\"a.pdf\" size=10 mime=\"application/pdf\"/><paragraph>b</paragraph>", "steps": [{"key": "Mod+a"}, {"type": "x"}], "expect": {"doc": "<paragraph>x|</paragraph>"}},
    {"name": "undo brings back a deleted file card", "doc": "<paragraph>a</paragraph>^<fileAttachment url=\"/files/f1\" name=\"a.pdf\" size=10 mime=\"application/pdf\"/><paragraph>b</paragraph>", "steps": [{"key": "Backspace"}, {"key": "Mod+z"}], "expect": {"doc": "<paragraph>a</paragraph>^<fileAttachment mime=\"application/pdf\" name=\"a.pdf\" size=10 url=\"/files/f1\"/><paragraph>b</paragraph>"}},
    {"name": "redo deletes the file card again", "doc": "<paragraph>a</paragraph>^<fileAttachment url=\"/files/f1\" name=\"a.pdf\" size=10 mime=\"application/pdf\"/><paragraph>b</paragraph>", "steps": [{"key": "Backspace"}, {"key": "Mod+z"}, {"key": "Mod+Shift+z"}], "expect": {"doc": "<paragraph>a</paragraph><paragraph>|b</paragraph>"}},
    {"name": "paste text over a selected file card", "doc": "<paragraph>a</paragraph>^<fileAttachment url=\"/files/f1\" name=\"a.pdf\" size=10 mime=\"application/pdf\"/><paragraph>b</paragraph>", "steps": [{"paste": {"text/plain": "xy"}}], "expect": {"doc": "<paragraph>a</paragraph><paragraph>xy|</paragraph><paragraph>b</paragraph>"}},
    {"name": "copy a selected file card", "doc": "<paragraph>a</paragraph>^<fileAttachment url=\"/files/f1\" name=\"a.pdf\" size=10 mime=\"application/pdf\"/><paragraph>b</paragraph>", "steps": [{"copy": {"text": "📎 a.pdf", "html": "<div data-url=\"/files/f1\" data-name=\"a.pdf\" data-size=\"10\" data-mime=\"application/pdf\" data-type=\"file\" class=\"file-card\" data-pm-slice=\"0 0 []\"><a href=\"/files/f1\" target=\"_blank\" rel=\"noopener noreferrer\">a.pdf</a></div>"}}], "expect": {"doc": "<paragraph>a</paragraph>^<fileAttachment url=\"/files/f1\" name=\"a.pdf\" size=10 mime=\"application/pdf\"/><paragraph>b</paragraph>"}},
    {"name": "cut a selected file card", "doc": "<paragraph>a</paragraph>^<fileAttachment url=\"/files/f1\" name=\"a.pdf\" size=10 mime=\"application/pdf\"/><paragraph>b</paragraph>", "steps": [{"copy": {}, "cut": true}], "expect": {"doc": "<paragraph>a</paragraph><paragraph>|b</paragraph>"}},
    {"name": "two file cards: deleting the first keeps the second", "doc": "^<fileAttachment url=\"/files/f1\" name=\"a.pdf\" size=10 mime=\"application/pdf\"/><fileAttachment url=\"/files/f1\" name=\"a.pdf\" size=10 mime=\"application/pdf\"/><paragraph>b</paragraph>", "steps": [{"key": "Backspace"}], "expect": {"doc": "^<fileAttachment mime=\"application/pdf\" name=\"a.pdf\" size=10 url=\"/files/f1\"/><paragraph>b</paragraph>"}},
    {"name": "a file card as the last block gets a paragraph after it", "doc": "<paragraph>a|</paragraph><fileAttachment url=\"/files/f1\" name=\"a.pdf\" size=10 mime=\"application/pdf\"/>", "steps": [{"type": "x"}], "expect": {"doc": "<paragraph>ax|</paragraph><fileAttachment url=\"/files/f1\" name=\"a.pdf\" size=10 mime=\"application/pdf\"/><paragraph></paragraph>"}},
    {"name": "paste an image's HTML into an empty line", "doc": "<paragraph>|</paragraph>", "steps": [{"paste": {"text/html": "<img src=\"/uploads/y1.png\">"}}], "expect": {"doc": "^<image src=\"/uploads/y1.png\"/><paragraph/>"}},
    {"name": "paste an image's HTML between words", "doc": "<paragraph>a|b</paragraph>", "steps": [{"paste": {"text/html": "<p>x</p><img src=\"/uploads/y1.png\"><p>z</p>"}}], "expect": {"doc": "<paragraph>ax</paragraph><image src=\"/uploads/y1.png\"/><paragraph>z|b</paragraph>"}},
    {"name": "paste an inline base64 image is dropped", "doc": "<paragraph>|</paragraph>", "steps": [{"paste": {"text/html": "<img src=\"data:image/png;base64,AAAA\">"}}], "expect": {"doc": "<paragraph>|</paragraph>"}},
    {"name": "paste an image over a selected image", "doc": "^<image src=\"/uploads/x1.png\"/><paragraph>b</paragraph>", "steps": [{"paste": {"text/html": "<img src=\"/uploads/y1.png\">"}}], "expect": {"doc": "<image src=\"/uploads/y1.png\"/><paragraph>|b</paragraph>"}},
    {"name": "Mod+z after typing next to an image", "doc": "<paragraph>a|</paragraph><image src=\"/uploads/x1.png\"/><paragraph>b</paragraph>", "steps": [{"type": "x"}, {"wait": 600}, {"key": "Mod+z"}], "expect": {"doc": "<paragraph>a|</paragraph><image src=\"/uploads/x1.png\"/><paragraph>b</paragraph>"}},
    {"name": "Backspace in a list item after an image does not eat the image", "doc": "<bulletList><listItem><paragraph>a</paragraph></listItem></bulletList><image src=\"/uploads/x1.png\"/><paragraph>|b</paragraph>", "steps": [{"key": "Backspace"}], "expect": {"doc": "<bulletList><listItem><paragraph>a</paragraph></listItem></bulletList><paragraph>|b</paragraph>"}},
    {"name": "a selected image then Mod+b changes nothing", "doc": "<paragraph>a</paragraph>^<image src=\"/uploads/x1.png\"/><paragraph>b</paragraph>", "steps": [{"key": "Mod+b"}], "expect": {"doc": "<paragraph>a</paragraph>^<image src=\"/uploads/x1.png\"/><paragraph>b</paragraph>"}},
    {"name": "Tab on a selected file card changes nothing", "doc": "<paragraph>a</paragraph>^<fileAttachment url=\"/files/f1\" name=\"a.pdf\" size=10 mime=\"application/pdf\"/><paragraph>b</paragraph>", "steps": [{"key": "Tab"}], "expect": {"doc": "<paragraph>a</paragraph><fileAttachment mime=\"application/pdf\" name=\"a.pdf\" size=10 url=\"/files/f1\"/><paragraph>b</paragraph>", "ignoreSelection": true}},
    {"name": "paste an external https image keeps it", "doc": "<paragraph>|</paragraph>", "steps": [{"paste": {"text/html": "<img src=\"https://example.com/i.png\" alt=\"pic\">"}}], "expect": {"doc": "^<image alt=\"pic\" src=\"https://example.com/i.png\"/><paragraph/>"}},
    {"name": "paste a javascript: image is dropped", "doc": "<paragraph>|</paragraph>", "steps": [{"paste": {"text/html": "<img src=\"javascript:alert(1)\">"}}], "expect": {"doc": "<paragraph>|</paragraph>"}, "skip": {"tiptap": "finding: an image with an unsafe src is pasted as an empty image node (no src) instead of being dropped"}},
    {"name": "paste a file card's HTML", "doc": "<paragraph>|</paragraph>", "steps": [{"paste": {"text/html": "<div data-type=\"file\" data-url=\"/files/f2\" data-name=\"b.txt\" data-size=\"5\" data-mime=\"text/plain\"></div>"}}], "expect": {"doc": "^<fileAttachment mime=\"text/plain\" name=\"b.txt\" size=5 url=\"/files/f2\"/><paragraph/>"}},
    {"name": "paste a file card with an unsafe link is dropped", "doc": "<paragraph>|</paragraph>", "steps": [{"paste": {"text/html": "<div data-type=\"file\" data-url=\"javascript:x\" data-name=\"b.txt\"></div>"}}], "expect": {"doc": "<paragraph>|</paragraph>"}, "skip": {"tiptap": "finding: a file card with an unsafe link is pasted as a card with no link (and no way to open it) instead of being dropped"}}
  ]
}
