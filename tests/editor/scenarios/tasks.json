{
  "scenarios": [
    { "name": "/task, a title, Enter makes the next task", "doc": "<paragraph>|</paragraph>",
      "steps": [{ "type": "/task" }, { "key": "Enter" }, { "type": "Buy milk" }, { "key": "Enter" }],
      "expect": { "doc": "<taskRef taskId=\"t1\"/><taskRef taskId=\"t2\"/><paragraph/>", "focus": "title:t2", "tasks": { "t1": { "title": "Buy milk" }, "t2": { "title": "" } } } },
    { "name": "Enter in an empty task title leaves task mode", "doc": "<paragraph>|</paragraph>",
      "steps": [{ "type": "/task" }, { "key": "Enter" }, { "type": "A" }, { "key": "Enter" }, { "key": "Enter" }],
      "expect": { "doc": "<taskRef taskId=\"t1\"/><paragraph>|</paragraph><paragraph/>", "focus": "editor", "tasks": { "t1": { "title": "A" } } } },
    { "name": "Backspace in an empty task title makes a plain line", "doc": "<paragraph>|</paragraph>",
      "steps": [{ "type": "/task" }, { "key": "Enter" }, { "key": "Backspace" }],
      "expect": { "doc": "<paragraph>|</paragraph><paragraph/>", "focus": "editor", "tasks": {} } },
    { "name": "Mod+Enter converts a line to a task", "doc": "<paragraph>Call Sam|</paragraph>",
      "steps": [{ "key": "Mod+Enter" }],
      "expect": { "doc": "<taskRef taskId=\"t1\"/><paragraph/>", "ignoreSelection": true, "tasks": { "t1": { "title": "Call Sam" } } } },
    { "name": "Mod+1 converts a line to a task", "doc": "<paragraph>Call Sam|</paragraph>",
      "steps": [{ "key": "Mod+1" }],
      "expect": { "doc": "<taskRef taskId=\"t1\"/><paragraph/>", "ignoreSelection": true, "tasks": { "t1": { "title": "Call Sam" } } } },
    { "name": "converting a bullet keeps its sub-points under the task", "doc": "<bulletList><listItem><paragraph>Plan|</paragraph><bulletList><listItem><paragraph>step</paragraph></listItem></bulletList></listItem></bulletList>",
      "steps": [{ "key": "Mod+Enter" }],
      "expect": { "doc": "<taskRef taskId=\"t1\"><bulletList><listItem><paragraph>step</paragraph></listItem></bulletList></taskRef><paragraph>|</paragraph>", "tasks": { "t1": { "title": "Plan" } } } },
    { "name": "a checked checklist item converts to a done task", "doc": "<taskList><taskItem checked=true><paragraph>Done thing|</paragraph></taskItem></taskList>",
      "steps": [{ "key": "Mod+Enter" }, { "wait": 50 }],
      "expect": { "doc": "<taskRef taskId=\"t1\"/><paragraph>|</paragraph>", "tasks": { "t1": { "title": "Done thing", "status": "done" } } } },
    { "name": "converting several selected lines makes several tasks", "doc": "<paragraph>[a</paragraph><paragraph>b]</paragraph>",
      "steps": [{ "key": "Mod+Enter" }],
      "expect": { "doc": "<taskRef taskId=\"t1\"/><taskRef taskId=\"t2\"/><paragraph/>", "ignoreSelection": true, "tasks": { "t1": { "title": "a" }, "t2": { "title": "b" } } } },
    { "name": "Tab on the line after a task moves it into the task's notes", "doc": "<taskRef taskId=\"t1\"/><paragraph>|note</paragraph>", "tasks": { "t1": { "title": "A" } },
      "steps": [{ "key": "Tab" }],
      "expect": { "doc": "<taskRef taskId=\"t1\"><paragraph>|note</paragraph></taskRef><paragraph/>", "tasks": { "t1": { "title": "A" } } } },
    { "name": "Tab on a bullet list's first line after a task moves the whole list in", "doc": "<taskRef taskId=\"t1\"/><bulletList><listItem><paragraph>|a</paragraph></listItem><listItem><paragraph>b</paragraph></listItem></bulletList>", "tasks": { "t1": { "title": "A" } },
      "steps": [{ "key": "Tab" }],
      "expect": { "doc": "<taskRef taskId=\"t1\"><bulletList><listItem><paragraph>|a</paragraph></listItem><listItem><paragraph>b</paragraph></listItem></bulletList></taskRef><paragraph/>" } },
    { "name": "Shift+Tab lifts a note line out of its task", "doc": "<taskRef taskId=\"t1\"><paragraph>|note</paragraph></taskRef><paragraph/>", "tasks": { "t1": { "title": "A" } },
      "steps": [{ "key": "Shift+Tab" }],
      "expect": { "doc": "<taskRef taskId=\"t1\"/><paragraph>|note</paragraph><paragraph/>" } },
    { "name": "Enter on an empty last note line leaves the task", "doc": "<taskRef taskId=\"t1\"><paragraph>note</paragraph><paragraph>|</paragraph></taskRef><paragraph/>", "tasks": { "t1": { "title": "A" } },
      "steps": [{ "key": "Enter" }],
      "expect": { "doc": "<taskRef taskId=\"t1\"><paragraph>note</paragraph></taskRef><paragraph>|</paragraph><paragraph/>" } },
    { "name": "Tab in a task title makes it a subtask of the task above", "doc": "<taskRef taskId=\"t1\"/><paragraph>|</paragraph>", "tasks": { "t1": { "title": "Parent" } },
      "steps": [{ "type": "/task" }, { "key": "Enter" }, { "type": "Child" }, { "key": "Tab" }, { "wait": 200 }],
      "expect": { "doc": "<taskRef taskId=\"t1\"><taskRef taskId=\"t2\"/></taskRef><paragraph/>", "tasks": { "t1": { "title": "Parent" }, "t2": { "title": "Child" } } } },
    { "name": "Shift+Tab in a subtask title takes it back out", "doc": "<taskRef taskId=\"t1\"><taskRef taskId=\"t2\"/></taskRef><paragraph>|</paragraph>", "tasks": { "t1": { "title": "Parent" }, "t2": { "title": "Child" } },
      "steps": [{ "focusTitle": "t2" }, { "key": "Shift+Tab" }, { "wait": 200 }],
      "expect": { "doc": "<taskRef taskId=\"t1\"/><taskRef taskId=\"t2\"/><paragraph/>", "focus": "title:t2" } },
    { "name": "Backspace across a selected task line deletes the task", "doc": "<paragraph>[a</paragraph><taskRef taskId=\"t1\"/><paragraph>b]</paragraph>", "tasks": { "t1": { "title": "A" } },
      "steps": [{ "key": "Backspace" }],
      "expect": { "doc": "<paragraph>|</paragraph>", "tasks": {} } },
    { "name": "undo after deleting a task line brings the task back", "doc": "<paragraph>[a</paragraph><taskRef taskId=\"t1\"/><paragraph>b]</paragraph>", "tasks": { "t1": { "title": "A" } },
      "steps": [{ "key": "Backspace" }, { "key": "Mod+z" }, { "wait": 100 }],
      "expect": { "doc": "<paragraph>|a</paragraph><taskRef taskId=\"t1\"/><paragraph>b</paragraph>", "tasks": { "t1": { "title": "A" } } } },
    { "name": "undoing a convert-to-task removes the task", "doc": "<paragraph>Call Sam|</paragraph>",
      "steps": [{ "key": "Mod+Enter" }, { "wait": 50 }, { "key": "Mod+z" }, { "wait": 100 }],
      "expect": { "doc": "<paragraph>Call Sam</paragraph>", "ignoreSelection": true, "tasks": {} } },
    { "name": "redo of a convert-to-task recreates the task", "doc": "<paragraph>Call Sam|</paragraph>",
      "steps": [{ "key": "Mod+Enter" }, { "wait": 50 }, { "key": "Mod+z" }, { "wait": 100 }, { "key": "Mod+Shift+z" }, { "wait": 100 }],
      "expect": { "doc": "<taskRef taskId=\"t1\"/><paragraph/>", "ignoreSelection": true, "tasks": { "t1": { "title": "Call Sam" } } } },
    {"name": "Mod+Enter on three lines skips the empty one", "doc": "<paragraph>[a</paragraph><paragraph></paragraph><paragraph>b]</paragraph>", "steps": [{"key": "Mod+Enter"}], "expect": {"ignoreSelection": true, "doc": "<taskRef taskId=\"t1\"></taskRef><paragraph></paragraph><taskRef taskId=\"t2\"></taskRef><paragraph></paragraph>", "tasks": {"t1": {"title": "a"}, "t2": {"title": "b"}}}},
    {"name": "Mod+Enter on a note line makes a subtask", "doc": "<taskRef taskId=\"t1\"><paragraph>sub|</paragraph></taskRef><paragraph/>", "tasks": {"t1": {"title": "Pack"}}, "steps": [{"key": "Mod+Enter"}], "expect": {"doc": "<taskRef taskId=\"t1\"><taskRef taskId=\"t2\"></taskRef></taskRef><paragraph>|</paragraph>", "tasks": {"t1": {"title": "Pack"}, "t2": {"title": "sub"}}}},
    {"name": "Mod+Enter on two bullets keeps each one's sub-points", "doc": "<bulletList><listItem><paragraph>[a</paragraph><bulletList><listItem><paragraph>a1</paragraph></listItem></bulletList></listItem><listItem><paragraph>b]</paragraph></listItem></bulletList>", "steps": [{"key": "Mod+Enter"}], "expect": {"doc": "<taskRef taskId=\"t1\"><bulletList><listItem><paragraph>a1</paragraph></listItem></bulletList></taskRef><taskRef taskId=\"t2\"></taskRef><paragraph>|</paragraph>", "tasks": {"t1": {"title": "a"}, "t2": {"title": "b"}}}},
    {"name": "Tab on a checklist after a task moves it into the task's notes", "doc": "<taskRef taskId=\"t1\"/><taskList><taskItem><paragraph>|x</paragraph></taskItem></taskList>", "tasks": {"t1": {"title": "Pack"}}, "steps": [{"key": "Tab"}], "expect": {"doc": "<taskRef taskId=\"t1\"><taskList><taskItem><paragraph>|x</paragraph></taskItem></taskList></taskRef><paragraph></paragraph>", "tasks": {"t1": {"title": "Pack"}}}},
    {"name": "Enter in a bullet in a task's notes continues the bullet", "doc": "<taskRef taskId=\"t1\"><bulletList><listItem><paragraph>a|</paragraph></listItem></bulletList></taskRef><paragraph/>", "tasks": {"t1": {"title": "Pack"}}, "steps": [{"key": "Enter"}, {"type": "b"}], "expect": {"doc": "<taskRef taskId=\"t1\"><bulletList><listItem><paragraph>a</paragraph></listItem><listItem><paragraph>b|</paragraph></listItem></bulletList></taskRef><paragraph></paragraph>", "tasks": {"t1": {"title": "Pack"}}}},
    {"name": "Mod+Enter on a selection across a task and a line keeps the task", "doc": "<paragraph>[x</paragraph><taskRef taskId=\"t1\"/><paragraph>y]</paragraph>", "tasks": {"t1": {"title": "Pack"}}, "steps": [{"key": "Mod+Enter"}], "expect": {"ignoreSelection": true, "doc": "<taskRef taskId=\"t2\"></taskRef><taskRef taskId=\"t1\"></taskRef><taskRef taskId=\"t3\"></taskRef><paragraph></paragraph>", "tasks": {"t1": {"title": "Pack"}, "t2": {"title": "x"}, "t3": {"title": "y"}}}}
  ]
}
