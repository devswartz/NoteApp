{
  "scenarios": [
    { "name": "/callout makes a callout", "doc": "<paragraph>|</paragraph>",
      "steps": [{ "type": "/callout" }, { "key": "Enter" }, { "type": "x" }],
      "expect": { "doc": "<callout><paragraph>x|</paragraph></callout><paragraph/>" } },
    { "name": "Enter twice leaves a callout", "doc": "<callout><paragraph>x|</paragraph></callout><paragraph/>",
      "steps": [{ "key": "Enter" }, { "key": "Enter" }],
      "expect": { "doc": "<callout><paragraph>x</paragraph></callout><paragraph>|</paragraph><paragraph/>" } },
    { "name": "/toggle makes a toggle", "doc": "<paragraph>|</paragraph>",
      "steps": [{ "type": "/toggle" }, { "key": "Enter" }, { "type": "T" }],
      "expect": { "doc": "<details><detailsSummary>T|</detailsSummary><detailsContent><paragraph/></detailsContent></details><paragraph/>" } },
    { "name": "Enter in a closed toggle's summary makes a line after the toggle", "doc": "<details><detailsSummary>T|</detailsSummary><detailsContent><paragraph/></detailsContent></details><paragraph/>",
      "steps": [{ "key": "Enter" }, { "type": "a" }],
      "expect": { "doc": "<details><detailsSummary>T</detailsSummary><detailsContent><paragraph/></detailsContent></details><paragraph>a|</paragraph><paragraph/>" } },
    { "name": "Enter on an empty last toggle line leaves the toggle",
      "skip": { "tiptap": "needs the toggle open, which is view state the harness can't set yet; behaviour from src/editor/blockExit.ts" }, "doc": "<details><detailsSummary>T</detailsSummary><detailsContent><paragraph>a</paragraph><paragraph>|</paragraph></detailsContent></details><paragraph/>",
      "steps": [{ "key": "Enter" }],
      "expect": { "doc": "<details><detailsSummary>T</detailsSummary><detailsContent><paragraph>a</paragraph></detailsContent></details><paragraph>|</paragraph><paragraph/>" } },
    { "name": "/h1 makes a heading", "doc": "<paragraph>|</paragraph>",
      "steps": [{ "type": "/h1" }, { "key": "Enter" }, { "type": "T" }],
      "expect": { "doc": "<heading level=1>T|</heading><paragraph/>" } },
    { "name": "/ then Escape leaves the text", "doc": "<paragraph>|</paragraph>",
      "steps": [{ "type": "/ta" }, { "key": "Escape" }],
      "expect": { "doc": "<paragraph>/ta|</paragraph>" } },
    { "name": "/code makes a code block", "doc": "<paragraph>|</paragraph>",
      "steps": [{ "type": "/code" }, { "key": "Enter" }, { "type": "x" }],
      "expect": { "doc": "<codeBlock>x|</codeBlock><paragraph/>" } },
    {"name": "Backspace at the start of a callout unwraps it", "doc": "<callout><paragraph>|x</paragraph></callout><paragraph/>", "steps": [{"key": "Backspace"}], "expect": {"doc": "<paragraph>|x</paragraph><paragraph/>"}},
    {"name": "Backspace on an empty last callout line moves it out", "doc": "<callout><paragraph>x</paragraph><paragraph>|</paragraph></callout><paragraph/>", "steps": [{"key": "Backspace"}], "expect": {"doc": "<callout><paragraph>x</paragraph></callout><paragraph>|</paragraph><paragraph/>"}},
    {"name": "Enter in the middle of a callout line splits it in the callout", "doc": "<callout><paragraph>ab|cd</paragraph></callout><paragraph/>", "steps": [{"key": "Enter"}], "expect": {"doc": "<callout><paragraph>ab</paragraph><paragraph>|cd</paragraph></callout><paragraph/>"}},
    {"name": "- in a callout makes a bullet inside it", "doc": "<callout><paragraph>|</paragraph></callout><paragraph/>", "steps": [{"type": "- a"}], "expect": {"doc": "<callout><bulletList><listItem><paragraph>a|</paragraph></listItem></bulletList></callout><paragraph/>"}},
    {"name": "Backspace at the start of a quote unwraps it", "doc": "<blockquote><paragraph>|q</paragraph></blockquote><paragraph/>", "steps": [{"key": "Backspace"}], "expect": {"doc": "<paragraph>|q</paragraph><paragraph/>"}},
    {"name": "Mod+Shift+b in a quote unwraps it", "doc": "<blockquote><paragraph>q|</paragraph></blockquote><paragraph/>", "steps": [{"key": "Mod+Shift+b"}], "expect": {"doc": "<paragraph>q|</paragraph><paragraph/>"}},
    {"name": "typing in a toggle's summary", "doc": "<details><detailsSummary>T|</detailsSummary><detailsContent><paragraph/></detailsContent></details><paragraph/>", "steps": [{"type": "ab"}], "expect": {"doc": "<details><detailsSummary>Tab|</detailsSummary><detailsContent><paragraph/></detailsContent></details><paragraph/>"}},
    {"name": "Mod+a in a callout then Backspace", "doc": "<callout><paragraph>a|b</paragraph></callout><paragraph>c</paragraph>", "steps": [{"key": "Mod+a"}, {"key": "Backspace"}], "expect": {"doc": "<paragraph>|</paragraph>"}},
    {"name": "Mod+a in a quote then typing", "doc": "<blockquote><paragraph>a|b</paragraph></blockquote>", "steps": [{"key": "Mod+a"}, {"type": "x"}], "expect": {"doc": "<paragraph>x|</paragraph>"}},
    {"name": "Mod+a in a table cell then typing", "doc": "<table><tableRow><tableCell><paragraph>a|</paragraph></tableCell><tableCell><paragraph>b</paragraph></tableCell></tableRow></table><paragraph/>", "steps": [{"key": "Mod+a"}, {"type": "x"}], "expect": {"doc": "<paragraph>x|</paragraph>"}},
    {"name": "Mod+a in a code block then typing replaces everything with a paragraph", "doc": "<codeBlock>a|b</codeBlock><paragraph>c</paragraph>", "steps": [{"key": "Mod+a"}, {"type": "x"}], "expect": {"doc": "<paragraph>x|</paragraph>"}}
  ]
}
