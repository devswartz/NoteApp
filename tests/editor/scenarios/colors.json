{
  "scenarios": [
    {"name": "a new text colour replaces the old one", "doc": "<paragraph><textStyle color=\"red\">[ab]</textStyle></paragraph>", "steps": [{"command": "setColor", "args": {"color": "blue"}}], "expect": {"doc": "<paragraph><textStyle color=\"blue\">[ab</textStyle>]</paragraph>"}},
    {"name": "a colour over part of a coloured range splits it", "doc": "<paragraph><textStyle color=\"red\">a[b]c</textStyle></paragraph>", "steps": [{"command": "setColor", "args": {"color": "blue"}}], "expect": {"doc": "<paragraph><textStyle color=\"red\">a</textStyle><textStyle color=\"blue\">[b</textStyle><textStyle color=\"red\">]c</textStyle></paragraph>"}},
    {"name": "a colour over a range that starts in another colour", "doc": "<paragraph><textStyle color=\"red\">a[b</textStyle>c]d</paragraph>", "steps": [{"command": "setColor", "args": {"color": "blue"}}], "expect": {"doc": "<paragraph><textStyle color=\"red\">a</textStyle><textStyle color=\"blue\">[bc</textStyle>]d</paragraph>"}},
    {"name": "a colour over two paragraphs", "doc": "<paragraph>a[b</paragraph><paragraph>c]d</paragraph>", "steps": [{"command": "setColor", "args": {"color": "green"}}], "expect": {"doc": "<paragraph>a<textStyle color=\"green\">[b</textStyle></paragraph><paragraph><textStyle color=\"green\">c</textStyle>]d</paragraph>"}},
    {"name": "unsetColor removes the colour of the selection", "doc": "<paragraph><textStyle color=\"red\">[ab]</textStyle></paragraph>", "steps": [{"command": "unsetColor"}], "expect": {"doc": "<paragraph>[ab]</paragraph>"}},
    {"name": "unsetColor on part of a coloured range", "doc": "<paragraph><textStyle color=\"red\">a[b]c</textStyle></paragraph>", "steps": [{"command": "unsetColor"}], "expect": {"doc": "<paragraph><textStyle color=\"red\">a</textStyle>[b<textStyle color=\"red\">]c</textStyle></paragraph>"}},
    {"name": "unsetColor on text with no colour changes nothing", "doc": "<paragraph>a[b]c</paragraph>", "steps": [{"command": "unsetColor"}], "expect": {"doc": "<paragraph>a[b]c</paragraph>"}},
    {"name": "a colour over bold text keeps the bold", "doc": "<paragraph>a<bold>[bc]</bold>d</paragraph>", "steps": [{"command": "setColor", "args": {"color": "red"}}], "expect": {"doc": "<paragraph>a<textStyle color=\"red\"><bold>[bc</bold></textStyle>]d</paragraph>"}},
    {"name": "Mod+b over coloured text keeps the colour", "doc": "<paragraph>a<textStyle color=\"red\">[bc]</textStyle>d</paragraph>", "steps": [{"key": "Mod+b"}], "expect": {"doc": "<paragraph>a<textStyle color=\"red\"><bold>[bc</bold></textStyle>]d</paragraph>"}},
    {"name": "a colour over a link", "doc": "<paragraph><link href=\"https://example.com\">[ab]</link></paragraph>", "steps": [{"command": "setColor", "args": {"color": "purple"}}], "expect": {"doc": "<paragraph><link href=\"https://example.com\"><textStyle color=\"purple\">[ab</textStyle></link>]</paragraph>"}},
    {"name": "a colour over inline code does nothing (code excludes other marks)", "doc": "<paragraph><code>[ab]</code></paragraph>", "steps": [{"command": "setColor", "args": {"color": "red"}}], "expect": {"doc": "<paragraph><code>[ab</code>]</paragraph>"}},
    {"name": "a colour over a heading's text", "doc": "<heading level=2>[ab]</heading>", "steps": [{"command": "setColor", "args": {"color": "orange"}}], "expect": {"doc": "<heading level=2><textStyle color=\"orange\">[ab</textStyle>]</heading><paragraph/>"}},
    {"name": "a colour over a list item", "doc": "<bulletList><listItem><paragraph>[ab]</paragraph></listItem></bulletList>", "steps": [{"command": "setColor", "args": {"color": "pink"}}], "expect": {"doc": "<bulletList><listItem><paragraph><textStyle color=\"pink\">[ab</textStyle>]</paragraph></listItem></bulletList><paragraph/>"}},
    {"name": "a colour over a table cell's text", "doc": "<table><tableRow><tableCell><paragraph>[ab]</paragraph></tableCell></tableRow></table>", "steps": [{"command": "setColor", "args": {"color": "gray"}}], "expect": {"doc": "<table><tableRow><tableCell><paragraph><textStyle color=\"gray\">[ab</textStyle>]</paragraph></tableCell></tableRow></table><paragraph/>"}},
    {"name": "typing at the end of coloured text continues the colour", "doc": "<paragraph>a<textStyle color=\"red\">b|</textStyle></paragraph>", "steps": [{"type": "c"}], "expect": {"doc": "<paragraph>a<textStyle color=\"red\">bc</textStyle>|</paragraph>"}},
    {"name": "typing at the start of coloured text is plain", "doc": "<paragraph>a|<textStyle color=\"red\">b</textStyle></paragraph>", "steps": [{"type": "c"}], "expect": {"doc": "<paragraph>ac<textStyle color=\"red\">|b</textStyle></paragraph>"}},
    {"name": "a colour with a caret colours what is typed next", "doc": "<paragraph>a|</paragraph>", "steps": [{"command": "setColor", "args": {"color": "red"}}, {"type": "b"}], "expect": {"doc": "<paragraph>a<textStyle color=\"red\">b</textStyle>|</paragraph>"}},
    {"name": "a colour with a caret, then Mod+b, then typing", "doc": "<paragraph>a|</paragraph>", "steps": [{"command": "setColor", "args": {"color": "red"}}, {"key": "Mod+b"}, {"type": "b"}], "expect": {"doc": "<paragraph>a<textStyle color=\"red\"><bold>b</bold></textStyle>|</paragraph>"}},
    {"name": "Enter inside coloured text keeps the colour on both lines", "doc": "<paragraph><textStyle color=\"red\">ab|cd</textStyle></paragraph>", "steps": [{"key": "Enter"}, {"type": "x"}], "expect": {"doc": "<paragraph><textStyle color=\"red\">ab</textStyle></paragraph><paragraph><textStyle color=\"red\">x|cd</textStyle></paragraph>"}},
    {"name": "Backspace over coloured text, then typing continues the colour", "doc": "<paragraph>a<textStyle color=\"red\">[b]</textStyle>c</paragraph>", "steps": [{"key": "Backspace"}, {"type": "x"}], "expect": {"doc": "<paragraph>a<textStyle color=\"red\">x</textStyle>|c</paragraph>"}},
    {"name": "typing over a coloured selection takes the colour", "doc": "<paragraph><textStyle color=\"red\">a[b]c</textStyle></paragraph>", "steps": [{"type": "x"}], "expect": {"doc": "<paragraph><textStyle color=\"red\">ax|c</textStyle></paragraph>"}},
    {"name": "unsetColor with a caret in coloured text: what is typed next is plain", "doc": "<paragraph><textStyle color=\"red\">ab|</textStyle></paragraph>", "steps": [{"command": "unsetColor"}, {"type": "x"}], "expect": {"doc": "<paragraph><textStyle color=\"red\">ab</textStyle>x|</paragraph>"}, "skip": {"tiptap": "finding: the typed text carries an empty textStyle mark (colour removed, mark left): invisible, but it stays in the document"}},
    {"name": "undo takes back a colour", "doc": "<paragraph>[ab]</paragraph>", "steps": [{"command": "setColor", "args": {"color": "red"}}, {"command": "undo"}], "expect": {"doc": "<paragraph>[ab]</paragraph>"}},
    {"name": "a highlight replaces another highlight", "doc": "<paragraph><highlight color=\"yellow\">[ab]</highlight></paragraph>", "steps": [{"command": "setHighlight", "args": {"color": "green"}}], "expect": {"doc": "<paragraph><highlight color=\"green\">[ab</highlight>]</paragraph>"}},
    {"name": "a highlight over part of a highlight", "doc": "<paragraph><highlight color=\"yellow\">a[b]c</highlight></paragraph>", "steps": [{"command": "setHighlight", "args": {"color": "blue"}}], "expect": {"doc": "<paragraph><highlight color=\"yellow\">a</highlight><highlight color=\"blue\">[b</highlight><highlight color=\"yellow\">]c</highlight></paragraph>"}},
    {"name": "unsetHighlight removes a highlight", "doc": "<paragraph><highlight color=\"yellow\">[ab]</highlight></paragraph>", "steps": [{"command": "unsetHighlight"}], "expect": {"doc": "<paragraph>[ab]</paragraph>"}},
    {"name": "unsetHighlight on part of a highlight", "doc": "<paragraph><highlight color=\"yellow\">a[b]c</highlight></paragraph>", "steps": [{"command": "unsetHighlight"}], "expect": {"doc": "<paragraph><highlight color=\"yellow\">a</highlight>[b<highlight color=\"yellow\">]c</highlight></paragraph>"}},
    {"name": "a highlight and a text colour together", "doc": "<paragraph>[ab]</paragraph>", "steps": [{"command": "setHighlight", "args": {"color": "yellow"}}, {"command": "setColor", "args": {"color": "red"}}], "expect": {"doc": "<paragraph><textStyle color=\"red\"><highlight color=\"yellow\">[ab</highlight></textStyle>]</paragraph>"}},
    {"name": "unsetColor keeps the highlight", "doc": "<paragraph><highlight color=\"yellow\"><textStyle color=\"red\">[ab]</textStyle></highlight></paragraph>", "steps": [{"command": "unsetColor"}], "expect": {"doc": "<paragraph><highlight color=\"yellow\">[ab</highlight>]</paragraph>"}},
    {"name": "typing at the end of a highlight continues it", "doc": "<paragraph>a<highlight color=\"yellow\">b|</highlight></paragraph>", "steps": [{"type": "c"}], "expect": {"doc": "<paragraph>a<highlight color=\"yellow\">bc</highlight>|</paragraph>"}},
    {"name": "Mod+Shift+h highlights", "doc": "<paragraph>a[b]c</paragraph>", "steps": [{"key": "Mod+Shift+h"}], "expect": {"doc": "<paragraph>a<highlight>[b</highlight>]c</paragraph>"}},
    {"name": "Mod+Shift+h twice removes the highlight", "doc": "<paragraph>a[b]c</paragraph>", "steps": [{"key": "Mod+Shift+h"}, {"key": "Mod+Shift+h"}], "expect": {"doc": "<paragraph>a[b]c</paragraph>"}},
    {"name": "a highlight over two paragraphs", "doc": "<paragraph>a[b</paragraph><paragraph>c]d</paragraph>", "steps": [{"command": "setHighlight", "args": {"color": "pink"}}], "expect": {"doc": "<paragraph>a<highlight color=\"pink\">[b</highlight></paragraph><paragraph><highlight color=\"pink\">c</highlight>]d</paragraph>"}},
    {"name": "a highlight over a comment keeps both", "doc": "<paragraph><comment threadId=\"c1\">[ab]</comment></paragraph>", "steps": [{"command": "setHighlight", "args": {"color": "yellow"}}], "expect": {"doc": "<paragraph><highlight color=\"yellow\"><comment threadId=\"c1\">[ab</comment></highlight>]</paragraph>"}},
    {"name": "paste HTML highlight with a palette colour", "doc": "<paragraph>|</paragraph>", "steps": [{"paste": {"text/html": "<p>a<mark data-color=\"green\">b</mark></p>"}}], "expect": {"doc": "<paragraph>a<highlight color=\"green\">b</highlight>|</paragraph>"}},
    {"name": "paste HTML highlight with an unknown colour name", "doc": "<paragraph>|</paragraph>", "steps": [{"paste": {"text/html": "<p>a<mark data-color=\"teal\">b</mark></p>"}}], "expect": {"doc": "<paragraph>a<highlight>b</highlight>|</paragraph>"}},
    {"name": "paste HTML highlight with an inline background is a plain highlight", "doc": "<paragraph>|</paragraph>", "steps": [{"paste": {"text/html": "<p>a<mark style=\"background-color:#ff0\">b</mark></p>"}}], "expect": {"doc": "<paragraph>a<highlight>b</highlight>|</paragraph>"}},
    {"name": "paste HTML text with an unknown colour name drops it", "doc": "<paragraph>|</paragraph>", "steps": [{"paste": {"text/html": "<p><span data-color=\"teal\">a</span></p>"}}], "expect": {"doc": "<paragraph>a|</paragraph>"}},
    {"name": "paste HTML with a font colour drops it", "doc": "<paragraph>|</paragraph>", "steps": [{"paste": {"text/html": "<p><font color=\"red\">a</font><span style=\"color: red\">b</span></p>"}}], "expect": {"doc": "<paragraph>ab|</paragraph>"}},
    {"name": "paste HTML colour inside bold", "doc": "<paragraph>|</paragraph>", "steps": [{"paste": {"text/html": "<p><strong><span data-color=\"red\">a</span></strong>b</p>"}}], "expect": {"doc": "<paragraph><textStyle color=\"red\"><bold>a</bold></textStyle>b|</paragraph>"}},
    {"name": "paste HTML colour and highlight together", "doc": "<paragraph>|</paragraph>", "steps": [{"paste": {"text/html": "<p><mark data-color=\"yellow\"><span data-color=\"red\">a</span></mark></p>"}}], "expect": {"doc": "<paragraph><textStyle color=\"red\"><highlight color=\"yellow\">a</highlight></textStyle>|</paragraph>"}},
    {"name": "paste plain text over a coloured selection", "doc": "<paragraph>a<textStyle color=\"red\">[bc]</textStyle>d</paragraph>", "steps": [{"paste": {"text/plain": "xy"}}], "expect": {"doc": "<paragraph>axy|d</paragraph>"}},
    {"name": "paste plain text inside coloured text takes the colour", "doc": "<paragraph><textStyle color=\"red\">a|b</textStyle></paragraph>", "steps": [{"paste": {"text/plain": "xy"}}], "expect": {"doc": "<paragraph><textStyle color=\"red\">axy|b</textStyle></paragraph>"}},
    {"name": "paste coloured HTML into coloured text", "doc": "<paragraph><textStyle color=\"red\">a|b</textStyle></paragraph>", "steps": [{"paste": {"text/html": "<p><span data-color=\"blue\">xy</span></p>"}}], "expect": {"doc": "<paragraph><textStyle color=\"red\">a</textStyle><textStyle color=\"blue\">xy</textStyle><textStyle color=\"red\">|b</textStyle></paragraph>"}},
    {"name": "copy coloured text", "doc": "<paragraph>a<textStyle color=\"red\">[bc]</textStyle>d</paragraph>", "steps": [{"copy": {"text": "bc", "html": "<p data-pm-slice=\"1 1 []\"><span data-color=\"red\">bc</span></p>"}}], "expect": {"doc": "<paragraph>a<textStyle color=\"red\">[bc]</textStyle>d</paragraph>"}},
    {"name": "copy a highlight", "doc": "<paragraph>a<highlight color=\"yellow\">[bc]</highlight>d</paragraph>", "steps": [{"copy": {"text": "bc", "html": "<p data-pm-slice=\"1 1 []\"><mark data-color=\"yellow\">bc</mark></p>"}}], "expect": {"doc": "<paragraph>a<highlight color=\"yellow\">[bc]</highlight>d</paragraph>"}},
    {"name": "select-all, colour, then typing replaces it all", "doc": "<paragraph>a</paragraph><paragraph>b|</paragraph>", "steps": [{"key": "Mod+a"}, {"command": "setColor", "args": {"color": "red"}}, {"type": "x"}], "expect": {"doc": "<paragraph>x|</paragraph>"}}
  ]
}
