<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push notifications (APNs). Xcode switches this to "production" when exporting for TestFlight/App Store. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Universal links: https://app.notiveloapp.com/w/… and https://staging.notiveloapp.com/w/… open the app. The server serves
	     /.well-known/apple-app-site-association once APNS_TEAM_ID (or APPLE_TEAM_ID) is set; see docs/MOBILE.md. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:app.notiveloapp.com</string>
		<string>applinks:staging.notiveloapp.com</string>
	</array>
	<!-- Shared container with the Share Extension and the Today widget (ios/App/Shared/SharedStore.swift). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.devswartz.notivelo</string>
	</array>
</dict>
</plist>
