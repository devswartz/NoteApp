<Project Sdk="Microsoft.NET.Sdk">
  <!-- Plain xunit tests for the XAML-free half of the box text view (Notivelo.Windows/Text): offset and run mapping, type scale,
       indentation, gaps, table shapes. Compiles those sources and the core's generated bindings directly, so no WinUI is needed.
       Run `bash crates/nv-core/build-windows.sh` first (the bindings), then `dotnet test apps/windows/Notivelo.Windows.Tests`. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CS1591;CS8981;CS0108;CS0109;CS8618;CS0169;CS0649;CS8600;CS8601;CS8602;CS8603;CS8604;CS8625;CS8765;CS8767</NoWarn>
    <NvCoreDir>$(MSBuildThisFileDirectory)..\..\..\target\windows\NotiveloCore\</NvCoreDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\Notivelo.Windows\Text\*.cs" Link="Text\%(Filename)%(Extension)" />
    <Compile Include="..\Notivelo.Windows\Data\Account.cs" Link="Data\Account.cs" />
    <Compile Include="..\Notivelo.Windows\Data\AppSettings.cs" Link="Data\AppSettings.cs" />
    <Compile Include="..\Notivelo.Windows\Data\InkTool.cs" Link="Data\InkTool.cs" />
    <Compile Include="..\Notivelo.Windows\Data\Models.cs" Link="Data\Models.cs" />
    <Compile Include="..\Notivelo.Windows\Data\PageTools.cs" Link="Data\PageTools.cs" />
    <Compile Include="..\Notivelo.Windows\Data\People.cs" Link="Data\People.cs" />
    <Compile Include="..\Notivelo.Windows\Data\Presence.cs" Link="Data\Presence.cs" />
    <Compile Include="..\Notivelo.Windows\Data\ShellPolish.cs" Link="Data\ShellPolish.cs" />
    <Compile Include="..\Notivelo.Windows\Data\AuditBatch.cs" Link="Data\AuditBatch.cs" />
    <Compile Include="..\Notivelo.Windows\Data\WorkspaceAdmin.cs" Link="Data\WorkspaceAdmin.cs" />
    <Compile Include="..\Notivelo.Windows\Data\TaskLogic.cs" Link="Data\TaskLogic.cs" />
    <Compile Include="..\Notivelo.Windows\Data\TaskViews.cs" Link="Data\TaskViews.cs" />
    <Compile Include="..\Notivelo.Windows\Data\SavedViews.cs" Link="Data\SavedViews.cs" />
    <Compile Include="..\Notivelo.Windows\Data\ShellKeys.cs" Link="Data\ShellKeys.cs" />
    <Compile Include="..\Notivelo.Windows\Data\OfflineStart.cs" Link="Data\OfflineStart.cs" />
    <Compile Include="..\Notivelo.Windows\Data\TrayRules.cs" Link="Data\TrayRules.cs" />
    <Compile Include="..\Notivelo.Windows\Data\HotkeyRules.cs" Link="Data\HotkeyRules.cs" />
    <Compile Include="$(NvCoreDir)generated\nv_core.cs" Link="Native\nv_core.cs" />
    <Content Include="$(NvCoreDir)runtimes\win-x64\native\nv_core.dll" Link="nv_core.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(NvCoreDir)runtimes\win-x64\native\nv_core.dll')" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
</Project>
