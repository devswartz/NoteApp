<UserControl
    x:Class="Notivelo.Windows.ShellView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
    <!-- LOOK 3.1: ribbon on top, then rail 64 | sidebar 216 (180-420, resizable) | main. Chrome and page pick their own theme (Hybrid). -->
    <Grid x:Name="Root" Background="{ThemeResource BgSidebar}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border x:Name="RibbonHost" Background="{ThemeResource BgSidebar}" BorderBrush="{ThemeResource Border}" BorderThickness="0,0,0,1" />
        <Grid x:Name="Body" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64" />
                <ColumnDefinition x:Name="SidebarColumn" Width="217" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="RailHost" Background="{ThemeResource BgSidebar}" BorderBrush="{ThemeResource Border}" BorderThickness="0,0,1,0" />
            <Grid Grid.Column="1" x:Name="SidebarCell">
                <Border x:Name="SidebarHost" Background="{ThemeResource BgSidebar}" BorderBrush="{ThemeResource Border}" BorderThickness="0,0,1,0" />
            </Grid>
            <Grid Grid.Column="2" x:Name="MainHost" Background="{ThemeResource BgSidebar}">
                <Border x:Name="PageCard" Margin="6,6,6,0" CornerRadius="12,12,0,0" BorderThickness="1" />
                <Border x:Name="TasksHost" Background="{ThemeResource Bg}" Visibility="Collapsed" />
                <Border x:Name="CalendarHost" Background="{ThemeResource Bg}" Visibility="Collapsed" />
                <Border x:Name="SettingsHost" Background="{ThemeResource Bg}" Visibility="Collapsed" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
