                                    <VisualState.Setters>
                                        <Setter Target="Fill.Background" Value="{ThemeResource AccentSoft}" />
                                        <Setter Target="Content.Foreground" Value="{ThemeResource Accent}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="CheckedDisabled">
                                    <VisualState.Setters>
                                        <Setter Target="Fill.Background" Value="{ThemeResource AccentSoft}" />
                                        <Setter Target="Content.Foreground" Value="{ThemeResource Accent}" />
                                        <Setter Target="Root.Opacity" Value="0.4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

