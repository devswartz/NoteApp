                                </VisualState>
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Fill.Background" Value="{ThemeResource AccentSoft}" />
                                        <Setter Target="Content.Foreground" Value="{ThemeResource Accent}" />
                                    </VisualState.Setters>
