<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Notivelo.Windows</RootNamespace>
    <AssemblyName>Notivelo</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>MSIX</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <DefaultLanguage>en-US</DefaultLanguage>
    <!-- Dev/CI builds: no certificate, so the MSIX is unsigned (sideload it after signing with a test cert). -->
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <GenerateAppxPackageOnBuild>false</GenerateAppxPackageOnBuild>
    <AppxBundle>Never</AppxBundle>
    <UseRidGraph>true</UseRidGraph>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- All sources are UTF-8 (one invalid byte made csc read a whole file as ANSI: mojibake). -->
    <CodePage>65001</CodePage>
    <!-- The core's generated bindings (crates/nv-core/build-windows.sh) are compiled in; their warnings are not ours. -->
    <NoWarn>$(NoWarn);CS1591;CS8981;CS0108;CS0109;CS8618;CS0169;CS0649;CS8600;CS8601;CS8602;CS8603;CS8604;CS8625;CS8765;CS8767</NoWarn>
    <NvCoreDir>$(MSBuildThisFileDirectory)..\..\..\target\windows\NotiveloCore\</NvCoreDir>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Platform)' == 'ARM64'">
    <RuntimeIdentifier>win-arm64</RuntimeIdentifier>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)' != 'ARM64'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
    <Content Include="Assets\**" />
  </ItemGroup>

  <!-- The Rust core: bindings compiled into the app, nv_core.dll for the build's RID copied next to the exe (and into the MSIX).
       Run `bash crates/nv-core/build-windows.sh` first (NV_TARGETS="x86_64-pc-windows-msvc" for x64 only). -->
  <Target Name="NvCoreCheck" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(NvCoreDir)generated\nv_core.cs')" Text="The Rust core is not built: run 'bash crates/nv-core/build-windows.sh' (see docs/rewrite/status/windows.md)." />
    <Error Condition="!Exists('$(NvCoreDir)runtimes\$(RuntimeIdentifier)\native\nv_core.dll')" Text="Missing $(NvCoreDir)runtimes\$(RuntimeIdentifier)\native\nv_core.dll: build the core for this platform." />
  </Target>
  <ItemGroup>
    <Compile Include="$(NvCoreDir)generated\nv_core.cs" Link="Native\nv_core.cs" />
    <Content Include="$(NvCoreDir)runtimes\$(RuntimeIdentifier)\native\nv_core.dll" Link="nv_core.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250228001" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.3.2" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
  </ItemGroup>
</Project>
